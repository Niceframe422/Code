local ActiveKeyData      = nil
local lastRevalidateTime = 0

local function tryLoadSavedKey()
    local cfg = loadConfig()
    if not cfg or not cfg.Key or cfg.Key == "" then return false end
    local valid, label = checkExpiry(cfg.Expires)
    if not valid then saveConfig({}); return false end
    cfg.ExpiryLabel = label
    ActiveKeyData   = cfg
    return true
end

local keyAlreadyValid = tryLoadSavedKey()

local function startRevalidateLoop()
    if KEY_CFG.RevalidateEvery <= 0 or not ActiveKeyData then return end
    task.spawn(function()
        while task.wait(60) do
            if (unixNow() - lastRevalidateTime) >= KEY_CFG.RevalidateEvery then
                lastRevalidateTime = unixNow()
                local valid, data = validateKeyFull(ActiveKeyData.Key)
                if valid and type(data) == "table" then
                    ActiveKeyData = data; ActiveKeyData.SavedAt = unixNow(); saveConfig(ActiveKeyData)
                elseif not valid then
                    saveConfig({})
                    if game.CoreGui:FindFirstChild("ShopGui") then game.CoreGui.ShopGui:Destroy() end
                end
            end
        end
    end)
end

