local SelectedPlayer = LocalPlayer
local SelectedButton = nil
local onPlayerChangedCallbacks = {}

local function notifyPlayerChanged(p)
	for _, cb in ipairs(onPlayerChangedCallbacks) do cb(p) end
end

local function getInitials(name)
	local up = string.gmatch(name, "%u")
	local a, b = up(), up()
	if a and b then return a .. b
	elseif a then return a .. string.sub(name,2,2):upper()
	end
	return string.sub(name,1,2):upper()
end

local function selectPlayer(plr, btn)
	if SelectedButton then
		tween(SelectedButton, FAST, { BackgroundColor3 = Color3.fromRGB(26, 26, 26) })
		local l = SelectedButton:FindFirstChild("NameLabel")
		if l then tween(l, FAST, { TextColor3 = Color3.fromRGB(160, 160, 160) }) end
	end
	SelectedPlayer, SelectedButton = plr, btn
	tween(btn, FAST, { BackgroundColor3 = Color3.fromRGB(35, 65, 140) })
	local l = btn:FindFirstChild("NameLabel")
	if l then tween(l, FAST, { TextColor3 = Color3.fromRGB(140, 185, 255) }) end
	notifyPlayerChanged(plr)
end

