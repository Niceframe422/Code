local function unixNow() return os.time() end

local function checkExpiry(expires)
    if not expires or expires==0 then return true,"Permanent" end
    local r=expires-unixNow()
    if r<=0 then return false,"Expired" end
    local d,h,m=math.floor(r/86400),math.floor((r%86400)/3600),math.floor((r%3600)/60)
    if d>0 then return true,d.."d "..h.."h left"
    elseif h>0 then return true,h.."h "..m.."m left"
    else return true,m.."m left" end
end

local function validateKeyLocal(key)
    local u=key:upper():gsub("%s+","")
    for _,e in ipairs(HARDCODED_KEYS) do
        if (e.Key or ""):upper()==u then
            local v,l=checkExpiry(e.Expires)
            if v then return true,{Key=u,Tier=e.Tier or "Basic",Expires=e.Expires or 0,ExpiryLabel=l,Source="offline"}
            else return false,"Key has expired." end
        end
    end
    return false,nil
end

local function validateKeyFull(key)
    local u=key:upper():gsub("%s+","")
    if KEY_CFG.KeysURL~="" then
        local ok,res=pcall(function()
            local req=(syn and syn.request) or (http and http.request) or request
            if not req then error("no http") end
            return req({Url=KEY_CFG.KeysURL,Method="GET"})
        end)
        if ok and res and res.Body and res.Body~="" then
            local list=jsonDecode(res.Body)
            if type(list)=="table" then
                for _,e in ipairs(list) do
                    local ek=((e.key or e.Key) or ""):upper()
                    if ek==u then
                        local exp=tonumber(e.expires or e.Expires) or 0
                        local v,l=checkExpiry(exp)
                        if v then return true,{Key=u,Tier=e.tier or e.Tier or "Basic",Expires=exp,ExpiryLabel=l,Source="remote"}
                        else return false,"Key has expired." end
                    end
                end
                return false,"Invalid key."
            end
        end
    end
    return validateKeyLocal(u)
end

local ActiveKeyData=nil; local lastRevalidateTime=0

local function tryLoadSavedKey()
    local cfg=loadConfig(); if not cfg or not cfg.Key or cfg.Key=="" then return false end
    local v,l=checkExpiry(cfg.Expires); if not v then saveConfig({}); return false end
    cfg.ExpiryLabel=l; ActiveKeyData=cfg; return true
end
local keyAlreadyValid=tryLoadSavedKey()

local function startRevalidateLoop()
    if KEY_CFG.RevalidateEvery<=0 or not ActiveKeyData then return end
    task.spawn(function()
        while task.wait(60) do
            if (unixNow()-lastRevalidateTime)>=KEY_CFG.RevalidateEvery then
                lastRevalidateTime=unixNow()
                local v,d=validateKeyFull(ActiveKeyData.Key)
                if v and type(d)=="table" then ActiveKeyData=d; ActiveKeyData.SavedAt=unixNow(); saveConfig(ActiveKeyData)
                elseif not v then saveConfig({}); if game.CoreGui:FindFirstChild("ShopGui") then game.CoreGui.ShopGui:Destroy() end end
            end
        end
    end)
end

