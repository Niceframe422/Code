Grid.CellSize    = UDim2.new(0, 230, 0, 185)
Grid.CellPadding = UDim2.new(0, 10, 0, 10)
Grid.SortOrder   = Enum.SortOrder.LayoutOrder

local GridPad = Instance.new("UIPadding", ProductScroll)
GridPad.PaddingTop    = UDim.new(0, 12)
GridPad.PaddingBottom = UDim.new(0, 12)
GridPad.PaddingLeft   = UDim.new(0, 12)
GridPad.PaddingRight  = UDim.new(0, 12)

------------------------------------------------
-- FILTER STATE
------------------------------------------------
local ActiveFilter  = "All"
local FilterButtons = {}
local ProductCards  = {}

local function applyFilter(cat)
	ActiveFilter = cat
	for _, fb in pairs(FilterButtons) do
		local active = (fb.Category == cat)
		local col = active
			and (cat ~= "All" and categoryColor(cat) or Color3.fromRGB(90, 90, 105))
			or Color3.fromRGB(36, 36, 36)
		tween(fb.Button, FAST, { BackgroundColor3 = col })
		fb.Button.TextColor3 = active and Color3.fromRGB(240,240,240) or Color3.fromRGB(120,120,120)
	end
	for _, e in pairs(ProductCards) do
		e.Card.Visible = (cat == "All") or (e.Category == cat)
	end
end

for i, cat in ipairs(Categories) do
	local fb = Instance.new("TextButton", FilterScroll)
	fb.LayoutOrder      = i
	fb.AutoButtonColor  = false
	fb.BackgroundColor3 = cat == "All" and Color3.fromRGB(75,75,90) or Color3.fromRGB(36,36,36)
	fb.TextColor3       = cat == "All" and Color3.fromRGB(240,240,240) or Color3.fromRGB(120,120,120)
	fb.Font             = Enum.Font.Gotham
	fb.TextSize         = 12
	fb.Text             = cat
	fb.Size             = UDim2.new(0, 0, 0, 28)
	fb.AutomaticSize    = Enum.AutomaticSize.X
	fb.BorderSizePixel  = 0
	Instance.new("UICorner", fb).CornerRadius = UDim.new(1, 0)
	local p = Instance.new("UIPadding", fb)
	p.PaddingLeft, p.PaddingRight = UDim.new(0,12), UDim.new(0,12)

	fb.MouseEnter:Connect(function()
		if ActiveFilter ~= cat then tween(fb, FAST, { BackgroundColor3 = Color3.fromRGB(48, 48, 54) }) end
	end)
	fb.MouseLeave:Connect(function()
		if ActiveFilter ~= cat then tween(fb, FAST, { BackgroundColor3 = Color3.fromRGB(36, 36, 36) }) end
	end)
	fb.MouseButton1Click:Connect(function() applyFilter(cat) end)
	table.insert(FilterButtons, { Button = fb, Category = cat })
end

------------------------------------------------
-- CARD BUILDER  (grouped with qty selector)
------------------------------------------------
local function setLoading(btn, loading, label)
	btn.Active                 = not loading
	btn.Text                   = loading and "…" or label
	btn.BackgroundTransparency = loading and 0.55 or 0
end

local function createCard(data)
	local accent   = categoryColor(data.Category)
	local variants = data.Variants or {}
	local prices   = data.Prices   or {}
	local giftable = data.isGiftable == true

	-- Filter out entries with no NormalId (pass-store items)
	local usable = {}
	for _, v in ipairs(variants) do
		if v.NormalId then table.insert(usable, v) end
	end

	-- Selected variant index
	local selIdx = 1
	if #usable == 0 then
		-- Pass-store card: show info only
		selIdx = 0
	end

	local card = Instance.new("Frame", ProductScroll)
	card.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	card.BorderSizePixel  = 0
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)

	local stroke = Instance.new("UIStroke", card)
	stroke.Color        = Color3.fromRGB(255,255,255)
	stroke.Transparency = 0.88
	stroke.Thickness    = 0.5
	card.MouseEnter:Connect(function()
		tween(stroke, FAST, { Color = accent, Transparency = 0.42 })
	end)
	card.MouseLeave:Connect(function()
		tween(stroke, FAST, { Color = Color3.fromRGB(255,255,255), Transparency = 0.88 })
	end)

	-- Top accent bar
	local topBar = Instance.new("Frame", card)
	topBar.Size             = UDim2.new(1, 0, 0, 3)
	topBar.BackgroundColor3 = accent
	topBar.BorderSizePixel  = 0
	Instance.new("UICorner", topBar).CornerRadius = UDim.new(0, 10)
	local topCover = Instance.new("Frame", topBar)
	topCover.Size             = UDim2.new(1, 0, 0.5, 0)
	topCover.Position         = UDim2.new(0, 0, 0.5, 0)
	topCover.BackgroundColor3 = accent
	topCover.BorderSizePixel  = 0

	-- Badge
	local badge = Instance.new("TextLabel", card)
	badge.Size                   = UDim2.new(0, 0, 0, 16)
	badge.AutomaticSize          = Enum.AutomaticSize.X
	badge.Position               = UDim2.new(0, 10, 0, 10)
	badge.BackgroundColor3       = accent
	badge.BackgroundTransparency = 0.78
	badge.Text                   = data.Category
	badge.TextColor3             = accent
	badge.Font                   = Enum.Font.GothamBold
	badge.TextSize               = 9
	badge.BorderSizePixel        = 0
	Instance.new("UICorner", badge).CornerRadius = UDim.new(1, 0)
	local badgePad = Instance.new("UIPadding", badge)
	badgePad.PaddingLeft, badgePad.PaddingRight = UDim.new(0,6), UDim.new(0,6)

	-- Name
	local titleL = Instance.new("TextLabel", card)
	titleL.Size                   = UDim2.new(1, -16, 0, 38)
	titleL.Position               = UDim2.new(0, 8, 0, 30)
	titleL.BackgroundTransparency = 1
	titleL.Text                   = data.Display
	titleL.TextColor3             = Color3.fromRGB(215, 215, 215)
	titleL.Font                   = Enum.Font.GothamBold
	titleL.TextSize               = 13
	titleL.TextXAlignment         = Enum.TextXAlignment.Left
	titleL.TextYAlignment         = Enum.TextYAlignment.Top
	titleL.TextWrapped            = true

	-- Price label (updates with variant)
	local priceL = Instance.new("TextLabel", card)
	priceL.Size                   = UDim2.new(1, -16, 0, 16)
	priceL.Position               = UDim2.new(0, 8, 0, 70)
	priceL.BackgroundTransparency = 1
	priceL.TextColor3             = Color3.fromRGB(90, 200, 90)
	priceL.Font                   = Enum.Font.GothamBold
	priceL.TextSize               = 12
	priceL.TextXAlignment         = Enum.TextXAlignment.Left

	------------------------------------------------
	-- QUANTITY SELECTOR ROW (only when > 1 variant)
	------------------------------------------------
	local qtyRow = Instance.new("Frame", card)
	qtyRow.Size                   = UDim2.new(1, -16, 0, 26)
	qtyRow.Position               = UDim2.new(0, 8, 0, 92)
	qtyRow.BackgroundTransparency = 1
	qtyRow.BorderSizePixel        = 0

	local qtyLayout = Instance.new("UIListLayout", qtyRow)
	qtyLayout.FillDirection       = Enum.FillDirection.Horizontal
	qtyLayout.Padding             = UDim.new(0, 4)
	qtyLayout.VerticalAlignment   = Enum.VerticalAlignment.Center

	local qtyBtns = {}

	local function updateSelection(idx)
		selIdx = idx
		local v   = usable[idx]
		local qty = v and v.Qty or 1
		local p   = prices[qty]
		priceL.Text = p and formatPrice(p) or "Free"
		for i, qb in ipairs(qtyBtns) do
			local active = (i == idx)
			tween(qb, FAST, {
				BackgroundColor3 = active and accent or Color3.fromRGB(36, 36, 36),
				TextColor3       = active and Color3.fromRGB(20,20,20) or Color3.fromRGB(140,140,140),
			})
		end
	end

	if #usable > 1 then
		for i, v in ipairs(usable) do
			local label = v.Label or ("×" .. tostring(v.Qty))
			local qb = Instance.new("TextButton", qtyRow)
			qb.Size             = UDim2.new(0, 0, 1, 0)
			qb.AutomaticSize    = Enum.AutomaticSize.X
			qb.BackgroundColor3 = Color3.fromRGB(36, 36, 36)
			qb.TextColor3       = Color3.fromRGB(140, 140, 140)
			qb.Font             = Enum.Font.GothamBold
			qb.TextSize         = 11
			qb.Text             = label
			qb.AutoButtonColor  = false
			qb.BorderSizePixel  = 0
			Instance.new("UICorner", qb).CornerRadius = UDim.new(1, 0)
			local qp = Instance.new("UIPadding", qb)
			qp.PaddingLeft, qp.PaddingRight = UDim.new(0,8), UDim.new(0,8)
			local _i = i
			qb.MouseButton1Click:Connect(function() updateSelection(_i) end)
			table.insert(qtyBtns, qb)
		end
	else
		-- single variant: label shows qty inline in price
		qtyRow.Visible = false
	end

	-- Initialize display
	if #usable > 0 then
		updateSelection(1)
	else
		priceL.Text = formatPrice(data.Prices and next(data.Prices) and select(2, next(data.Prices))) or "See Store"
		qtyRow.Visible = false
	end

	------------------------------------------------
	-- ACTION BUTTONS
	------------------------------------------------
	local btnY = 0  -- offset from bottom
	local btnH = 30

	local buyBtn, giftBtn

	local function makeBtnFrame()
		local f = Instance.new("Frame", card)
		f.Size             = UDim2.new(1, -16, 0, btnH)
		f.Position         = UDim2.new(0, 8, 1, -(btnH + 10))
		f.BackgroundTransparency = 1
		f.BorderSizePixel  = 0
		return f
	end

	if #usable > 0 then
		local btnFrame = makeBtnFrame()
		local btnLayout = Instance.new("UIListLayout", btnFrame)
		btnLayout.FillDirection = Enum.FillDirection.Horizontal
		btnLayout.Padding       = UDim.new(0, 6)

		-- Buy button
		buyBtn = Instance.new("TextButton", btnFrame)
		buyBtn.BackgroundColor3 = Color3.fromRGB(28, 58, 130)
		buyBtn.TextColor3       = Color3.fromRGB(210, 210, 210)
		buyBtn.Font             = Enum.Font.GothamBold
		buyBtn.TextSize         = 12
		buyBtn.Text             = "Buy"
		buyBtn.AutoButtonColor  = false
		buyBtn.BorderSizePixel  = 0
		buyBtn.Size             = UDim2.new(giftable and 0.5 or 1, giftable and -3 or 0, 1, 0)
		Instance.new("UICorner", buyBtn).CornerRadius = UDim.new(0, 6)

		buyBtn.MouseEnter:Connect(function()
			tween(buyBtn, FAST, { BackgroundColor3 = Color3.fromRGB(40, 80, 180) })
		end)
		buyBtn.MouseLeave:Connect(function()
			tween(buyBtn, FAST, { BackgroundColor3 = Color3.fromRGB(28, 58, 130) })
		end)

		if giftable then
			giftBtn = Instance.new("TextButton", btnFrame)
			giftBtn.BackgroundColor3 = Color3.fromRGB(90, 30, 80)
			giftBtn.TextColor3       = Color3.fromRGB(210, 210, 210)
			giftBtn.Font             = Enum.Font.GothamBold
			giftBtn.TextSize         = 12
			giftBtn.Text             = "🎁 Gift"
			giftBtn.AutoButtonColor  = false
			giftBtn.BorderSizePixel  = 0
			giftBtn.Size             = UDim2.new(0.5, -3, 1, 0)
			Instance.new("UICorner", giftBtn).CornerRadius = UDim.new(0, 6)

			giftBtn.MouseEnter:Connect(function()
				tween(giftBtn, FAST, { BackgroundColor3 = Color3.fromRGB(140, 45, 115) })
			end)
			giftBtn.MouseLeave:Connect(function()
				tween(giftBtn, FAST, { BackgroundColor3 = Color3.fromRGB(90, 30, 80) })
			end)

			-- Show/hide based on selection
			local function refreshGiftVis(plr)
				if not card.Parent then return end
				local isSelf = (plr == LocalPlayer)
				giftBtn.Visible = not isSelf
				buyBtn.Size     = UDim2.new(isSelf and 1 or 0.5, isSelf and 0 or -3, 1, 0)
			end
			refreshGiftVis(SelectedPlayer)
			table.insert(onPlayerChangedCallbacks, refreshGiftVis)
		end

		-- BUY
		buyBtn.MouseButton1Click:Connect(function()
			if selIdx == 0 then return end
			local v = usable[selIdx]
			if not v or not v.NormalId then
				showToast("No purchasable ID for this item.", Color3.fromRGB(200,80,80))
				return
			end
			setLoading(buyBtn, true, "Buy")
			task.spawn(function()
				local ok, err = pcall(function() PurchaseRemote:InvokeServer(v.NormalId) end)
				setLoading(buyBtn, false, "Buy")
				if ok then
					showToast("Purchased " .. data.Display, accent)
				else
					showToast("Purchase failed: " .. tostring(err), Color3.fromRGB(200,80,80))
				end
			end)
		end)

		-- GIFT
		if giftable and giftBtn then
			giftBtn.MouseButton1Click:Connect(function()
				if SelectedPlayer == LocalPlayer then
					showToast("You can't gift to yourself.", Color3.fromRGB(200,80,80)); return
				end
				local target = Players:GetPlayerByUserId(SelectedPlayer.UserId)
				if not target then
					showToast("That player has left the game.", Color3.fromRGB(200,80,80)); return
				end
				local v = usable[selIdx]
				if not v or not v.NormalId then
					showToast("This item cannot be gifted.", Color3.fromRGB(200,80,80)); return
				end
				setLoading(giftBtn, true, "🎁 Gift")
				task.spawn(function()
					local ok, err = pcall(function()
						GiftRemote:FireServer({ productId = v.NormalId, targetUserId = target.UserId })
					end)
					setLoading(giftBtn, false, "🎁 Gift")
					if ok then
						showToast("Gifted " .. data.Display .. " → " .. target.Name, accent)
					else
						showToast("Gift failed: " .. tostring(err), Color3.fromRGB(200,80,80))
					end
				end)
			end)
		end
	else
		-- Pass-store: show "Game Pass" label
		local passL = Instance.new("TextLabel", card)
		passL.Size                   = UDim2.new(1, -16, 0, btnH)
		passL.Position               = UDim2.new(0, 8, 1, -(btnH + 10))
		passL.BackgroundTransparency = 1
		passL.Text                   = "Available in Game Pass Store"
		passL.TextColor3             = Color3.fromRGB(100, 100, 100)
		passL.Font                   = Enum.Font.Gotham
		passL.TextSize               = 11
		passL.TextXAlignment         = Enum.TextXAlignment.Center
	end

	table.insert(ProductCards, { Card = card, Category = data.Category })
end

for _, data in ipairs(Products) do
	createCard(data)
end

applyFilter("All")

