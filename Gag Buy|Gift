    --------------------------------------------------------
    local function setLoading(btn, loading, label)
        btn.Active=not loading; btn.Text=loading and "…" or label; btn.BackgroundTransparency=loading and 0.55 or 0
    end

    local function createCard(data)
        local accent   = categoryColor(data.Category)
        local variants = data.Variants or {}
        local prices   = data.Prices   or {}
        local giftable = data.isGiftable == true

        local usable = {}
        for _,v in ipairs(variants) do if v.NormalId then table.insert(usable,v) end end

        local selIdx = #usable>0 and 1 or 0

        local card=Instance.new("Frame",ProductScroll); card.BackgroundColor3=Color3.fromRGB(20,20,20); card.BorderSizePixel=0
        Instance.new("UICorner",card).CornerRadius=UDim.new(0,10)
        local stroke=Instance.new("UIStroke",card); stroke.Color=Color3.fromRGB(255,255,255); stroke.Transparency=0.88; stroke.Thickness=0.5
        card.MouseEnter:Connect(function() tw(stroke,FAST,{Color=accent,Transparency=0.42}) end)
        card.MouseLeave:Connect(function() tw(stroke,FAST,{Color=Color3.fromRGB(255,255,255),Transparency=0.88}) end)

        local topBar=Instance.new("Frame",card); topBar.Size=UDim2.new(1,0,0,3); topBar.BackgroundColor3=accent; topBar.BorderSizePixel=0
        Instance.new("UICorner",topBar).CornerRadius=UDim.new(0,10)
        local topCover=Instance.new("Frame",topBar); topCover.Size=UDim2.new(1,0,0.5,0); topCover.Position=UDim2.new(0,0,0.5,0)
        topCover.BackgroundColor3=accent; topCover.BorderSizePixel=0

        local badge=Instance.new("TextLabel",card); badge.Size=UDim2.new(0,0,0,16); badge.AutomaticSize=Enum.AutomaticSize.X
        badge.Position=UDim2.new(0,10,0,10); badge.BackgroundColor3=accent; badge.BackgroundTransparency=0.78
        badge.Text=data.Category; badge.TextColor3=accent; badge.Font=Enum.Font.GothamBold; badge.TextSize=9; badge.BorderSizePixel=0
        Instance.new("UICorner",badge).CornerRadius=UDim.new(1,0)
        local badgePad=Instance.new("UIPadding",badge); badgePad.PaddingLeft,badgePad.PaddingRight=UDim.new(0,6),UDim.new(0,6)

        local titleL=Instance.new("TextLabel",card); titleL.Size=UDim2.new(1,-16,0,38); titleL.Position=UDim2.new(0,8,0,30)
        titleL.BackgroundTransparency=1; titleL.Text=data.Display; titleL.TextColor3=Color3.fromRGB(215,215,215)
        titleL.Font=Enum.Font.GothamBold; titleL.TextSize=13; titleL.TextXAlignment=Enum.TextXAlignment.Left
        titleL.TextYAlignment=Enum.TextYAlignment.Top; titleL.TextWrapped=true

        local priceL=Instance.new("TextLabel",card); priceL.Size=UDim2.new(1,-16,0,16); priceL.Position=UDim2.new(0,8,0,70)
        priceL.BackgroundTransparency=1; priceL.TextColor3=Color3.fromRGB(90,200,90); priceL.Font=Enum.Font.GothamBold
        priceL.TextSize=12; priceL.TextXAlignment=Enum.TextXAlignment.Left

        -- ┌──────────────────────────────────────┐
        -- │  NEW: Balance warning label per card │
        -- └──────────────────────────────────────┘
        local balWarnL=Instance.new("TextLabel",card); balWarnL.Size=UDim2.new(1,-16,0,12); balWarnL.Position=UDim2.new(0,8,0,87)
        balWarnL.BackgroundTransparency=1; balWarnL.TextColor3=Color3.fromRGB(220,130,50); balWarnL.Font=Enum.Font.Gotham
        balWarnL.TextSize=9; balWarnL.TextXAlignment=Enum.TextXAlignment.Left; balWarnL.Text=""

        local qtyRow=Instance.new("Frame",card); qtyRow.Size=UDim2.new(1,-16,0,26); qtyRow.Position=UDim2.new(0,8,0,104)
        qtyRow.BackgroundTransparency=1; qtyRow.BorderSizePixel=0
        local qtyLayout=Instance.new("UIListLayout",qtyRow); qtyLayout.FillDirection=Enum.FillDirection.Horizontal
        qtyLayout.Padding=UDim.new(0,4); qtyLayout.VerticalAlignment=Enum.VerticalAlignment.Center

        local qtyBtns={}

        local function getCurrentPrice()
            if selIdx==0 then return nil end
            local v=usable[selIdx]; if not v then return nil end
            return prices[v.Qty]
        end

        local function updateBalWarn()
            local p = getCurrentPrice()
            if not p then balWarnL.Text=""; return end
            local bal = getTokenBalance()
            if bal and p > bal then
                balWarnL.Text = string.format("⚠ Need %d more", math.ceil(p-bal))
            else
                balWarnL.Text = ""
            end
        end

        local function updateSelection(idx)
            selIdx=idx
            local v=usable[idx]; local qty=v and v.Qty or 1; local p=prices[qty]
            priceL.Text = p and formatPrice(p) or "Free"
            updateBalWarn()
            for i2,qb in ipairs(qtyBtns) do
                local active=(i2==idx)
                tw(qb,FAST,{
                    BackgroundColor3=active and accent or Color3.fromRGB(36,36,36),
                    TextColor3=active and Color3.fromRGB(20,20,20) or Color3.fromRGB(140,140,140),
                })
            end
        end

        if #usable>1 then
            for i2,v in ipairs(usable) do
                local label=v.Label or ("×"..tostring(v.Qty))
                local qb=Instance.new("TextButton",qtyRow); qb.Size=UDim2.new(0,0,1,0); qb.AutomaticSize=Enum.AutomaticSize.X
                qb.BackgroundColor3=Color3.fromRGB(36,36,36); qb.TextColor3=Color3.fromRGB(140,140,140)
                qb.Font=Enum.Font.GothamBold; qb.TextSize=11; qb.Text=label; qb.AutoButtonColor=false; qb.BorderSizePixel=0
                Instance.new("UICorner",qb).CornerRadius=UDim.new(1,0)
                local qp=Instance.new("UIPadding",qb); qp.PaddingLeft,qp.PaddingRight=UDim.new(0,8),UDim.new(0,8)
                local _i=i2; qb.MouseButton1Click:Connect(function() updateSelection(_i) end)
                table.insert(qtyBtns,qb)
            end
        else
            qtyRow.Visible=false
        end

        if #usable>0 then updateSelection(1) else priceL.Text="See Store"; qtyRow.Visible=false end

        -- Refresh balance warn on interval (cards persist)
        task.spawn(function()
            while card.Parent do task.wait(6); updateBalWarn() end
        end)

        local btnH = 28
        if #usable > 0 then
            -- ── Button row (Buy, Gift, +Queue) ──────────────────────────
            local btnFrame=Instance.new("Frame",card); btnFrame.Size=UDim2.new(1,-16,0,btnH)
            btnFrame.Position=UDim2.new(0,8,1,-(btnH+8)); btnFrame.BackgroundTransparency=1; btnFrame.BorderSizePixel=0

            -- Determine slot widths based on giftable
            -- We always want a "+Queue" button on the right (optional small btn)
            -- Layout: [Buy or Gift (varies)] [+Q]
            local queueBtnW = 32  -- fixed px for "+Q" cart button

            local buyBtn=Instance.new("TextButton",btnFrame)
            buyBtn.BackgroundColor3=Color3.fromRGB(28,58,130); buyBtn.TextColor3=Color3.fromRGB(210,210,210)
            buyBtn.Font=Enum.Font.GothamBold; buyBtn.TextSize=11; buyBtn.Text="Buy"
            buyBtn.AutoButtonColor=false; buyBtn.BorderSizePixel=0
            Instance.new("UICorner",buyBtn).CornerRadius=UDim.new(0,6)
            buyBtn.MouseEnter:Connect(function() tw(buyBtn,FAST,{BackgroundColor3=Color3.fromRGB(40,80,180)}) end)
            buyBtn.MouseLeave:Connect(function() tw(buyBtn,FAST,{BackgroundColor3=Color3.fromRGB(28,58,130)}) end)

            local giftBtn
            if giftable then
                giftBtn=Instance.new("TextButton",btnFrame)
                giftBtn.BackgroundColor3=Color3.fromRGB(90,30,80); giftBtn.TextColor3=Color3.fromRGB(210,210,210)
                giftBtn.Font=Enum.Font.GothamBold; giftBtn.TextSize=11; giftBtn.Text="🎁 Gift"
                giftBtn.AutoButtonColor=false; giftBtn.BorderSizePixel=0
                Instance.new("UICorner",giftBtn).CornerRadius=UDim.new(0,6)
                giftBtn.MouseEnter:Connect(function() tw(giftBtn,FAST,{BackgroundColor3=Color3.fromRGB(140,45,115)}) end)
                giftBtn.MouseLeave:Connect(function() tw(giftBtn,FAST,{BackgroundColor3=Color3.fromRGB(90,30,80)}) end)
            end

            local addQueueBtn=Instance.new("TextButton",btnFrame)
            addQueueBtn.BackgroundColor3=Color3.fromRGB(30,55,30); addQueueBtn.TextColor3=Color3.fromRGB(80,200,80)
            addQueueBtn.Font=Enum.Font.GothamBold; addQueueBtn.TextSize=10; addQueueBtn.Text="+Q"
            addQueueBtn.AutoButtonColor=false; addQueueBtn.BorderSizePixel=0
            Instance.new("UICorner",addQueueBtn).CornerRadius=UDim.new(0,6)
            addQueueBtn.MouseEnter:Connect(function() tw(addQueueBtn,FAST,{BackgroundColor3=Color3.fromRGB(40,75,40)}) end)
            addQueueBtn.MouseLeave:Connect(function() tw(addQueueBtn,FAST,{BackgroundColor3=Color3.fromRGB(30,55,30)}) end)

            -- Layout function: called whenever player changes
            local function layoutButtons(plr)
                if not card.Parent then return end
                local isSelf=(plr==LocalPlayer)

                -- Non-giftable: only show Buy + Queue always (card visibility handled by filter)
                -- Giftable + self: Buy + Queue (gift hidden)
                -- Giftable + other: Gift + Queue (buy hidden)

                if not giftable then
                    -- no gift button exists
                    buyBtn.Visible=true
                    buyBtn.Size=UDim2.new(1,-(queueBtnW+6),1,0); buyBtn.Position=UDim2.new(0,0,0,0)
                    addQueueBtn.Size=UDim2.new(0,queueBtnW,1,0); addQueueBtn.Position=UDim2.new(0,btnFrame.AbsoluteSize.X-queueBtnW,0,0)
                elseif isSelf then
                    buyBtn.Visible=true
                    if giftBtn then giftBtn.Visible=false end
                    buyBtn.Size=UDim2.new(1,-(queueBtnW+6),1,0); buyBtn.Position=UDim2.new(0,0,0,0)
                    addQueueBtn.Size=UDim2.new(0,queueBtnW,1,0); addQueueBtn.Position=UDim2.new(1,-(queueBtnW),0,0)
                else
                    buyBtn.Visible=false
                    if giftBtn then
                        giftBtn.Visible=true
                        giftBtn.Size=UDim2.new(1,-(queueBtnW+6),1,0); giftBtn.Position=UDim2.new(0,0,0,0)
                    end
                    addQueueBtn.Size=UDim2.new(0,queueBtnW,1,0); addQueueBtn.Position=UDim2.new(1,-(queueBtnW),0,0)
                end
            end
            layoutButtons(SelectedPlayer)
            table.insert(onPlayerChangedCallbacks, layoutButtons)

            -- BUY click
            buyBtn.MouseButton1Click:Connect(function()
                if selIdx==0 then return end
                local v=usable[selIdx]; if not v or not v.NormalId then showToast("No purchasable ID.",Color3.fromRGB(200,80,80)); return end

                -- Balance check
                local p=getCurrentPrice(); local bal=getTokenBalance()
                if bal and p and p>bal then
                    showToast(string.format("⚠ Not enough tokens! Need %d, have %d.", math.ceil(p), math.floor(bal)), Color3.fromRGB(200,100,50))
                    return
                end

                setLoading(buyBtn,true,"Buy")
                task.spawn(function()
                    local ok,err=pcall(function() PurchaseRemote:InvokeServer(v.NormalId) end)
                    setLoading(buyBtn,false,"Buy")
                    if ok then showToast("Purchased "..data.Display, accent)
                    else showToast("Purchase failed: "..tostring(err), Color3.fromRGB(200,80,80)) end
                    task.wait(1); updateBalWarn(); refreshBalanceDisplay()
                end)
            end)

            -- GIFT click
            if giftable and giftBtn then
                giftBtn.MouseButton1Click:Connect(function()
                    if SelectedPlayer==LocalPlayer then showToast("You can't gift to yourself.",Color3.fromRGB(200,80,80)); return end
                    local target=Players:GetPlayerByUserId(SelectedPlayer.UserId)
                    if not target then showToast("That player has left the game.",Color3.fromRGB(200,80,80)); return end
                    local v=usable[selIdx]; if not v or not v.NormalId then showToast("This item cannot be gifted.",Color3.fromRGB(200,80,80)); return end

                    -- Balance check
                    local p=getCurrentPrice(); local bal=getTokenBalance()
                    if bal and p and p>bal then
                        showToast(string.format("⚠ Not enough tokens! Need %d, have %d.", math.ceil(p), math.floor(bal)), Color3.fromRGB(200,100,50))
                        return
                    end

                    setLoading(giftBtn,true,"🎁 Gift")
                    task.spawn(function()
                        local ok,err=pcall(function() GiftRemote:FireServer({ productId=v.NormalId, targetUserId=target.UserId }) end)
                        setLoading(giftBtn,false,"🎁 Gift")
                        if ok then showToast("Gifted "..data.Display.." → "..target.Name, accent)
                        else showToast("Gift failed: "..tostring(err), Color3.fromRGB(200,80,80)) end
                        task.wait(1); updateBalWarn(); refreshBalanceDisplay()
                    end)
                end)
            end

            -- ADD TO QUEUE click
            addQueueBtn.MouseButton1Click:Connect(function()
                if selIdx==0 then return end
                local v=usable[selIdx]; if not v or not v.NormalId then showToast("Can't queue this item.",Color3.fromRGB(200,80,80)); return end
                local isSelf=(SelectedPlayer==LocalPlayer)
                local isGift = giftable and not isSelf

                if isGift and SelectedPlayer==LocalPlayer then isGift=false end
                if isGift then
                    local target=Players:GetPlayerByUserId(SelectedPlayer.UserId)
                    if not target then showToast("Player has left.",Color3.fromRGB(200,80,80)); return end
                end

                local p=getCurrentPrice()
                addToCart({
                    display      = data.Display.." (×"..(v.Qty or 1)..")",
                    productId    = v.NormalId,
                    price        = p or 0,
                    isGift       = isGift,
                    targetName   = isGift and SelectedPlayer.Name or "",
                    targetUserId = isGift and SelectedPlayer.UserId or 0,
                })
                -- Flash button
                local origColor=Color3.fromRGB(30,55,30)
                tw(addQueueBtn,FAST,{BackgroundColor3=Color3.fromRGB(20,80,20)})
                task.delay(0.4, function() tw(addQueueBtn,FAST,{BackgroundColor3=origColor}) end)
                showToast("Added to queue: "..data.Display, Color3.fromRGB(50,160,80))
            end)

        else
            -- Pass store items (no NormalId)
            local passL=Instance.new("TextLabel",card); passL.Size=UDim2.new(1,-16,0,btnH)
            passL.Position=UDim2.new(0,8,1,-(btnH+8)); passL.BackgroundTransparency=1
            passL.Text="Available in Game Pass Store"; passL.TextColor3=Color3.fromRGB(100,100,100)
            passL.Font=Enum.Font.Gotham; passL.TextSize=11; passL.TextXAlignment=Enum.TextXAlignment.Center
        end

        table.insert(ProductCards, { Card=card, Category=data.Category, isGiftable=giftable })
    end

    for _,data in ipairs(Products) do createCard(data) end
    applyFilter("All")

    -- Entry animation
    Main.Position=UDim2.new(0.5,0,0.56,0); Main.BackgroundTransparency=1
    tw(Main, MED, { Position=UDim2.new(0.5,0,0.5,0), BackgroundTransparency=0 })
end  -- end bootShop()

-- ┌─────────────────────────────────────────────────────┐
-- │            KEY VALIDATION HANDLER                   │
-- └─────────────────────────────────────────────────────┘

local validating = false

local function runValidation(rawKey)
    if validating then return end
    if rawKey=="" then keyStatus.Text="Please enter a key."; keyStatus.TextColor3=Color3.fromRGB(180,80,80); return end
    validating=true; keyValidateBtn.Text="Checking…"; keyValidateBtn.Active=false
    keyStatus.Text="Contacting key server…"; keyStatus.TextColor3=Color3.fromRGB(80,80,120)

    task.spawn(function()
        local ok,result=validateKeyFull(rawKey)
        validating=false; keyValidateBtn.Text="Validate Key"; keyValidateBtn.Active=true

        if ok and type(result)=="table" then
            tw(keyCardStroke,MED,{Color=Color3.fromRGB(60,200,100)})
            tw(keyGlow,MED,{BackgroundColor3=Color3.fromRGB(60,200,100)})
            tw(glowCover,MED,{BackgroundColor3=Color3.fromRGB(60,200,100)})
            local tierCfg2=TIER_DISPLAY[result.Tier] or DEFAULT_TIER
            keyStatus.Text="✓  "..tierCfg2.Label.."  ·  "..result.ExpiryLabel
            keyStatus.TextColor3=tierCfg2.Color
            result.SavedAt=unixNow(); saveConfig(result); ActiveKeyData=result
            task.wait(0.8); bootShop()
        else
            tw(keyCardStroke,MED,{Color=Color3.fromRGB(200,60,60)})
            tw(keyGlow,MED,{BackgroundColor3=Color3.fromRGB(200,60,60)})
            tw(glowCover,MED,{BackgroundColor3=Color3.fromRGB(200,60,60)})
            local msg=type(result)=="string" and result or "Invalid key."
            keyStatus.Text="✗  "..msg; keyStatus.TextColor3=Color3.fromRGB(220,70,70)
            local origPos=KeyCard.Position
            for _=1,3 do
                tw(KeyCard,TweenInfo.new(0.06),{Position=UDim2.new(0.5,-8,0.5,0)}); task.wait(0.07)
                tw(KeyCard,TweenInfo.new(0.06),{Position=UDim2.new(0.5,8,0.5,0)}); task.wait(0.07)
            end
            tw(KeyCard,TweenInfo.new(0.1),{Position=origPos})
            task.delay(1.5,function()
                tw(keyCardStroke,MED,{Color=Color3.fromRGB(80,100,220)})
                tw(keyGlow,MED,{BackgroundColor3=Color3.fromRGB(80,120,255)})
                tw(glowCover,MED,{BackgroundColor3=Color3.fromRGB(80,120,255)})
            end)
        end
    end)
end

keyValidateBtn.MouseButton1Click:Connect(function() runValidation(keyInput.Text) end)
keyInput.FocusLost:Connect(function(enterPressed) if enterPressed then runValidation(keyInput.Text) end end)

-- ┌─────────────────────────────────────────────────────┐
-- │       AUTO-BOOT IF SAVED KEY ALREADY VALID          │
-- └─────────────────────────────────────────────────────┘

if keyAlreadyValid then
    keyStatus.Text="✓ Saved key loaded · "..(ActiveKeyData.ExpiryLabel or "")
    keyStatus.TextColor3=Color3.fromRGB(60,200,100)
    tw(keyCardStroke,MED,{Color=Color3.fromRGB(60,200,100)})
    task.delay(0.6, bootShop)
end
