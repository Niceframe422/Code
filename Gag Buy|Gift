    QRunBtn.MouseButton1Click:Connect(function()
        if cartRunning then return end
        if #Cart==0 then showToast("Queue is empty.",Color3.fromRGB(150,100,50),"⚠"); return end
        local bal=getTokenBalance(); local total=cartTotal()
        if bal and total>bal then
            local deficit=math.ceil(total-bal)
            showToast("Not enough tokens! Need "..fmtNum(deficit).." more.",Color3.fromRGB(220,100,50),"⚠"); return
        end
        cartRunning=true; QRunBtn.Text="Running…"; QRunBtn.Active=false
        local items={}; for _,v in ipairs(Cart) do table.insert(items,v) end; clearCart()
        task.spawn(function()
            local ok_c,fail_c=0,0
            for idx,item in ipairs(items) do
                QStatusLabel.Text=string.format("[%d/%d] %s…",idx,#items,item.display)
                if item.isGift then
                    local target=Players:GetPlayerByUserId(item.targetUserId)
                    if not target then fail_c=fail_c+1; task.wait(.3)
                    else
                        local ok,_=pcall(function() GiftRemote:FireServer({productId=item.productId,targetUserId=item.targetUserId}) end)
                        if ok then ok_c=ok_c+1 else fail_c=fail_c+1 end; task.wait(Settings.QueueDelay)
                    end
                else
                    local ok,_=pcall(function() PurchaseRemote:InvokeServer(item.productId) end)
                    if ok then ok_c=ok_c+1 else fail_c=fail_c+1 end; task.wait(Settings.QueueDelay)
                end
            end
            cartRunning=false; QRunBtn.Text="▶ Run All"; QRunBtn.Active=true
            QStatusLabel.Text=string.format("Done · %d ok · %d failed",ok_c,fail_c)
            local col=fail_c>0 and Color3.fromRGB(200,130,50) or Color3.fromRGB(50,200,90)
            showToast(string.format("Queue done: %d purchased, %d failed.",ok_c,fail_c),col,fail_c>0 and "⚠" or "✓")
            refreshBal()
            task.delay(5,function() QStatusLabel.Text="" end)
        end)
    end)

