    local ActiveFilter="All"
    local FilterBtns={}
    local ProductCards={}  -- {Card, Category, isGiftable, updateBalWarn, updateLayout}

    local function applyFilter(cat)
        ActiveFilter=cat
        local isSelf=(SelectedPlayer==LocalPlayer)
        for _,fb in pairs(FilterBtns) do
            local active=(fb.Category==cat)
            local col=active and (cat~="All" and catColor(cat) or Color3.fromRGB(90,90,105)) or Color3.fromRGB(36,36,36)
            tw(fb.Button,FAST,{BackgroundColor3=col}); fb.Button.TextColor3=active and Color3.fromRGB(240,240,240) or Color3.fromRGB(120,120,120)
        end
        for _,e in pairs(ProductCards) do
            local catOk=(cat=="All") or (e.Category==cat)
            local giftOk=isSelf or e.isGiftable
            local passHide=Settings.HidePassItems and e.Category=="Pass"
            local testHide=not Settings.ShowTestingCat and e.Category=="Testing"
            e.Card.Visible=catOk and giftOk and not passHide and not testHide
        end
    end

    table.insert(onPlayerChanged,function(_) applyFilter(ActiveFilter) end)

    for i,cat in ipairs(Categories) do
        local fb=Instance.new("TextButton",FilterScroll); fb.LayoutOrder=i; fb.AutoButtonColor=false
