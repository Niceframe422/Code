-- Reads token balance from the game UI object
local function getTokenBalance()
    local plrGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not plrGui then return nil end
    local ui = plrGui:FindFirstChild("TradeTokenCurrency_UI", true)
    if not ui then return nil end
    for _, desc in ipairs(ui:GetDescendants()) do
        if desc.Name == "val" and desc:IsA("NumberValue") then
            return desc.Value
        end
    end
    return nil
end

