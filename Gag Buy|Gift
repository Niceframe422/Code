local function safeReadFile(path)
    local ok, data = pcall(readfile, path)
    return ok and data or nil
end
local function safeWriteFile(path, content) pcall(writefile, path, content) end
local function jsonEncode(t) local ok,s = pcall(HttpService.JSONEncode,HttpService,t); return ok and s or nil end
local function jsonDecode(s) local ok,t = pcall(HttpService.JSONDecode,HttpService,s); return ok and t or nil end
local function loadConfig() local r = safeReadFile(KEY_CFG.ConfigFile); if not r or r=="" then return nil end; return jsonDecode(r) end
local function saveConfig(data) local e=jsonEncode(data); if e then safeWriteFile(KEY_CFG.ConfigFile,e) end end

-- ┌─────────────────────────────────────────────────────┐
-- │                  KEY VALIDATION                     │
-- └─────────────────────────────────────────────────────┘

local function unixNow() return os.time() end

local function checkExpiry(expires)
    if not expires or expires == 0 then return true, "Permanent" end
    local remaining = expires - unixNow()
    if remaining <= 0 then return false, "Expired" end
    local days = math.floor(remaining / 86400)
    local hrs  = math.floor((remaining % 86400) / 3600)
    local mins = math.floor((remaining % 3600)  / 60)
    if days > 0 then return true, days.."d "..hrs.."h left"
    elseif hrs > 0 then return true, hrs.."h "..mins.."m left"
    else return true, mins.."m left" end
end

local function validateKeyLocal(key)
    local upper = key:upper():gsub("%s+","")
    for _, entry in ipairs(HARDCODED_KEYS) do
        if (entry.Key or ""):upper() == upper then
            local valid, label = checkExpiry(entry.Expires)
            if valid then
                return true, { Key=upper, Tier=entry.Tier or "Basic", Expires=entry.Expires or 0, ExpiryLabel=label, Source="offline" }
            else return false, "Key has expired." end
        end
    end
    return false, nil
end

local function validateKeyFull(key)
    local upper = key:upper():gsub("%s+","")
    if KEY_CFG.KeysURL ~= "" then
        local ok, res = pcall(function()
            local req = (syn and syn.request) or (http and http.request) or (request)
            if not req then error("no http func") end
            return req({ Url = KEY_CFG.KeysURL, Method = "GET" })
        end)
        if ok and res and res.Body and res.Body ~= "" then
            local list = jsonDecode(res.Body)
            if type(list) == "table" then
                for _, entry in ipairs(list) do
                    local ek = ((entry.key or entry.Key) or ""):upper()
                    if ek == upper then
                        local exp = tonumber(entry.expires or entry.Expires) or 0
                        local valid, label = checkExpiry(exp)
                        if valid then
                            return true, { Key=upper, Tier=entry.tier or entry.Tier or "Basic", Expires=exp, ExpiryLabel=label, Source="remote" }
                        else return false, "Key has expired." end
                    end
                end
                return false, "Invalid key."
            end
        end
    end
    return validateKeyLocal(upper)
end

