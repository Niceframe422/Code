    local confirmPendingMap={}  -- card→bool for double-click confirm

    local function createCard(data)
        local accent=catColor(data.Category)
        local variants=data.Variants or {}; local prices=data.Prices or {}
        local giftable=data.isGiftable==true

        local usable={}
        for _,v in ipairs(variants) do if v.NormalId then table.insert(usable,v) end end

        local selIdx=#usable>0 and 1 or 0

        local card=Instance.new("Frame",ProductScroll)
        card.BackgroundColor3=Color3.fromRGB(20,20,20); card.BorderSizePixel=0
        Instance.new("UICorner",card).CornerRadius=UDim.new(0,10)
        local stroke=Instance.new("UIStroke",card); stroke.Color=Color3.fromRGB(255,255,255); stroke.Transparency=.88; stroke.Thickness=.5
        card.MouseEnter:Connect(function() tw(stroke,FAST,{Color=accent,Transparency=.42}) end)
        card.MouseLeave:Connect(function() tw(stroke,FAST,{Color=Color3.fromRGB(255,255,255),Transparency=.88}) end)

        -- Top accent bar
        local topBar=Instance.new("Frame",card); topBar.Size=UDim2.new(1,0,0,3); topBar.BackgroundColor3=accent; topBar.BorderSizePixel=0
        Instance.new("UICorner",topBar).CornerRadius=UDim.new(0,10)
        local topCover=Instance.new("Frame",topBar); topCover.Size=UDim2.new(1,0,.5,0); topCover.Position=UDim2.new(0,0,.5,0); topCover.BackgroundColor3=accent; topCover.BorderSizePixel=0

        -- Badge
        local badge=Instance.new("TextLabel",card); badge.Size=UDim2.new(0,0,0,16); badge.AutomaticSize=Enum.AutomaticSize.X
        badge.Position=UDim2.new(0,10,0,10); badge.BackgroundColor3=accent; badge.BackgroundTransparency=.78
        badge.Text=data.Category; badge.TextColor3=accent; badge.Font=Enum.Font.GothamBold; badge.TextSize=9; badge.BorderSizePixel=0
        Instance.new("UICorner",badge).CornerRadius=UDim.new(1,0)
        local bp=Instance.new("UIPadding",badge); bp.PaddingLeft,bp.PaddingRight=UDim.new(0,6),UDim.new(0,6)

        local titleL=Instance.new("TextLabel",card); titleL.Size=UDim2.new(1,-16,0,36); titleL.Position=UDim2.new(0,8,0,30)
        titleL.BackgroundTransparency=1; titleL.Text=data.Display; titleL.TextColor3=Color3.fromRGB(215,215,215)
        titleL.Font=Enum.Font.GothamBold; titleL.TextSize=12; titleL.TextXAlignment=Enum.TextXAlignment.Left
        titleL.TextYAlignment=Enum.TextYAlignment.Top; titleL.TextWrapped=true

        local priceL=Instance.new("TextLabel",card); priceL.Size=UDim2.new(1,-16,0,14); priceL.Position=UDim2.new(0,8,0,68)
        priceL.BackgroundTransparency=1; priceL.TextColor3=Color3.fromRGB(90,200,90); priceL.Font=Enum.Font.GothamBold
        priceL.TextSize=11; priceL.TextXAlignment=Enum.TextXAlignment.Left

        -- Balance warning label (per card)
        local balWarn=Instance.new("TextLabel",card); balWarn.Size=UDim2.new(1,-16,0,11); balWarn.Position=UDim2.new(0,8,0,84)
        balWarn.BackgroundTransparency=1; balWarn.TextColor3=Color3.fromRGB(215,100,50); balWarn.Font=Enum.Font.Gotham
        balWarn.TextSize=9; balWarn.TextXAlignment=Enum.TextXAlignment.Left; balWarn.Text=""

        -- Qty row
        local qtyRow=Instance.new("Frame",card); qtyRow.Size=UDim2.new(1,-16,0,24); qtyRow.Position=UDim2.new(0,8,0,99)
        qtyRow.BackgroundTransparency=1; qtyRow.BorderSizePixel=0
        local ql=Instance.new("UIListLayout",qtyRow); ql.FillDirection=Enum.FillDirection.Horizontal; ql.Padding=UDim.new(0,4); ql.VerticalAlignment=Enum.VerticalAlignment.Center
        local qtyBtns={}

        local function getCurPrice()
            if selIdx==0 then return nil end
            local v=usable[selIdx]; return v and prices[v.Qty] or nil
        end

        local function updateBalWarn()
            if not Settings.ShowBalanceOnCard then balWarn.Text=""; return end
            local p=getCurPrice(); if not p then balWarn.Text=""; return end
            local bal=getTokenBalance()
            if bal then
                if p>bal then
                    local deficit=math.ceil(p-bal)
                    balWarn.Text="⚠ Need "..fmtNum(deficit).." more tokens"
                    balWarn.TextColor3=Color3.fromRGB(215,100,50)
                else
                    balWarn.Text=""
                end
            else
                balWarn.Text=""
            end
            -- Dim card if can't afford and setting on
            if Settings.HighlightAfford and bal then
                card.BackgroundColor3=p>bal and Color3.fromRGB(16,14,14) or Color3.fromRGB(20,20,20)
            else
                card.BackgroundColor3=Color3.fromRGB(20,20,20)
            end
        end

        local function updateSelection(idx)
            selIdx=idx
            local v=usable[idx]; local qty=v and v.Qty or 1; local p=prices[qty]
            priceL.Text=p and fmtPrice(p) or "Free"
            updateBalWarn()
            for i2,qb in ipairs(qtyBtns) do
                local active=(i2==idx)
                tw(qb,FAST,{BackgroundColor3=active and accent or Color3.fromRGB(36,36,36),TextColor3=active and Color3.fromRGB(20,20,20) or Color3.fromRGB(140,140,140)})
            end
        end

        if #usable>1 then
            for i2,v in ipairs(usable) do
                local label=v.Label or ("×"..tostring(v.Qty))
                local qb=Instance.new("TextButton",qtyRow); qb.Size=UDim2.new(0,0,1,0); qb.AutomaticSize=Enum.AutomaticSize.X
                qb.BackgroundColor3=Color3.fromRGB(36,36,36); qb.TextColor3=Color3.fromRGB(140,140,140)
                qb.Font=Enum.Font.GothamBold; qb.TextSize=10; qb.Text=label; qb.AutoButtonColor=false; qb.BorderSizePixel=0
                Instance.new("UICorner",qb).CornerRadius=UDim.new(1,0)
                local qp=Instance.new("UIPadding",qb); qp.PaddingLeft,qp.PaddingRight=UDim.new(0,7),UDim.new(0,7)
                local _i=i2; qb.MouseButton1Click:Connect(function() updateSelection(_i) end)
                table.insert(qtyBtns,qb)
            end
        else
            qtyRow.Visible=false
        end

        if #usable>0 then updateSelection(1) else priceL.Text="See Store"; qtyRow.Visible=false end

        -- refresh balance warning on interval
        task.spawn(function() while card.Parent do task.wait(6); updateBalWarn() end end)

        if #usable>0 then
            local BH=28  -- button height
            local btnFrame=Instance.new("Frame",card)
            btnFrame.Size=UDim2.new(1,-16,0,BH); btnFrame.Position=UDim2.new(0,8,1,-(BH+8))
            btnFrame.BackgroundTransparency=1; btnFrame.BorderSizePixel=0

            local QW=30  -- +Q button width
            local buyBtn=Instance.new("TextButton",btnFrame)
            buyBtn.BackgroundColor3=Color3.fromRGB(28,58,130); buyBtn.TextColor3=Color3.fromRGB(210,210,210)
            buyBtn.Font=Enum.Font.GothamBold; buyBtn.TextSize=11; buyBtn.Text="Buy"
            buyBtn.AutoButtonColor=false; buyBtn.BorderSizePixel=0
            Instance.new("UICorner",buyBtn).CornerRadius=UDim.new(0,6)
            buyBtn.MouseEnter:Connect(function() tw(buyBtn,FAST,{BackgroundColor3=Color3.fromRGB(40,80,180)}) end)
            buyBtn.MouseLeave:Connect(function() tw(buyBtn,FAST,{BackgroundColor3=Color3.fromRGB(28,58,130)}) end)

            local giftBtn
            if giftable then
                giftBtn=Instance.new("TextButton",btnFrame)
                giftBtn.BackgroundColor3=Color3.fromRGB(90,30,80); giftBtn.TextColor3=Color3.fromRGB(210,210,210)
                giftBtn.Font=Enum.Font.GothamBold; giftBtn.TextSize=11; giftBtn.Text="🎁 Gift"
                giftBtn.AutoButtonColor=false; giftBtn.BorderSizePixel=0
                Instance.new("UICorner",giftBtn).CornerRadius=UDim.new(0,6)
                giftBtn.MouseEnter:Connect(function() tw(giftBtn,FAST,{BackgroundColor3=Color3.fromRGB(140,45,115)}) end)
                giftBtn.MouseLeave:Connect(function() tw(giftBtn,FAST,{BackgroundColor3=Color3.fromRGB(90,30,80)}) end)
            end

            local addQBtn=Instance.new("TextButton",btnFrame)
            addQBtn.BackgroundColor3=Color3.fromRGB(25,48,25); addQBtn.TextColor3=Color3.fromRGB(70,190,70)
            addQBtn.Font=Enum.Font.GothamBold; addQBtn.TextSize=9; addQBtn.Text="+Q"
            addQBtn.AutoButtonColor=false; addQBtn.BorderSizePixel=0; addQBtn.Size=UDim2.new(0,QW,1,0)
            Instance.new("UICorner",addQBtn).CornerRadius=UDim.new(0,6)
            addQBtn.MouseEnter:Connect(function() tw(addQBtn,FAST,{BackgroundColor3=Color3.fromRGB(35,65,35)}) end)
            addQBtn.MouseLeave:Connect(function() tw(addQBtn,FAST,{BackgroundColor3=Color3.fromRGB(25,48,25)}) end)

            local function layoutBtns(plr)
                if not card.Parent then return end
                local isSelf=(plr==LocalPlayer)
                local gap=4
                addQBtn.Position=UDim2.new(1,-QW,0,0)
                if not giftable then
                    buyBtn.Visible=true
                    buyBtn.Position=UDim2.new(0,0,0,0); buyBtn.Size=UDim2.new(1,-(QW+gap),1,0)
                elseif isSelf then
                    buyBtn.Visible=true; if giftBtn then giftBtn.Visible=false end
                    buyBtn.Position=UDim2.new(0,0,0,0); buyBtn.Size=UDim2.new(1,-(QW+gap),1,0)
                else
                    buyBtn.Visible=false
                    if giftBtn then
                        giftBtn.Visible=true
                        giftBtn.Position=UDim2.new(0,0,0,0); giftBtn.Size=UDim2.new(1,-(QW+gap),1,0)
                    end
                end
            end
            layoutBtns(SelectedPlayer)
            table.insert(onPlayerChanged,layoutBtns)

            -- BUY
            local confirmPending=false
            buyBtn.MouseButton1Click:Connect(function()
                if selIdx==0 then return end
                local v=usable[selIdx]; if not v or not v.NormalId then showToast("No ID for this item.",Color3.fromRGB(200,80,80),"✗"); return end
                local p=getCurPrice(); local bal=getTokenBalance()
                if bal and p and p>bal then
                    local deficit=math.ceil(p-bal)
                    showToast("Not enough tokens! Need "..fmtNum(deficit).." more.",Color3.fromRGB(220,100,50),"⚠"); return
                end
                -- Confirm double-click
                if Settings.ConfirmBuy then
                    if not confirmPending then
                        confirmPending=true; buyBtn.Text="Confirm?"; buyBtn.BackgroundColor3=Color3.fromRGB(180,100,20)
                        task.delay(2,function() if confirmPending then confirmPending=false; buyBtn.Text="Buy"; buyBtn.BackgroundColor3=Color3.fromRGB(28,58,130) end end)
                        return
                    end
                    confirmPending=false
                end
                buyBtn.Active=false; buyBtn.Text="…"; buyBtn.BackgroundTransparency=.5
                task.spawn(function()
                    local ok,_=pcall(function() PurchaseRemote:InvokeServer(v.NormalId) end)
                    buyBtn.Active=true; buyBtn.Text="Buy"; buyBtn.BackgroundTransparency=0
                    if ok then showToast("Purchased "..data.Display,accent,"✓") else showToast("Purchase failed.",Color3.fromRGB(200,80,80),"✗") end
                    task.wait(1); updateBalWarn(); refreshBal()
                end)
            end)

            -- GIFT
            if giftable and giftBtn then
                giftBtn.MouseButton1Click:Connect(function()
                    if SelectedPlayer==LocalPlayer then showToast("Can't gift to yourself.",Color3.fromRGB(200,80,80),"✗"); return end
                    local target=Players:GetPlayerByUserId(SelectedPlayer.UserId)
                    if not target then showToast("Player has left.",Color3.fromRGB(200,80,80),"✗"); return end
                    local v=usable[selIdx]; if not v or not v.NormalId then showToast("This item can't be gifted.",Color3.fromRGB(200,80,80),"✗"); return end
                    local p=getCurPrice(); local bal=getTokenBalance()
                    if bal and p and p>bal then
                        local deficit=math.ceil(p-bal)
                        showToast("Not enough tokens! Need "..fmtNum(deficit).." more.",Color3.fromRGB(220,100,50),"⚠"); return
                    end
                    giftBtn.Active=false; giftBtn.Text="…"; giftBtn.BackgroundTransparency=.5
                    task.spawn(function()
                        local ok,_=pcall(function() GiftRemote:FireServer({productId=v.NormalId,targetUserId=target.UserId}) end)
                        giftBtn.Active=true; giftBtn.Text="🎁 Gift"; giftBtn.BackgroundTransparency=0
                        if ok then showToast("Gifted "..data.Display.." → "..target.Name,accent,"🎁") else showToast("Gift failed.",Color3.fromRGB(200,80,80),"✗") end
                        task.wait(1); updateBalWarn(); refreshBal()
                    end)
                end)
            end

            -- ADD TO QUEUE
            addQBtn.MouseButton1Click:Connect(function()
                if selIdx==0 then return end
                local v=usable[selIdx]; if not v or not v.NormalId then showToast("Can't queue this item.",Color3.fromRGB(200,80,80),"✗"); return end
                local isSelf=(SelectedPlayer==LocalPlayer)
                local isGift=giftable and not isSelf
                if isGift then
                    local target=Players:GetPlayerByUserId(SelectedPlayer.UserId)
                    if not target then showToast("Player has left.",Color3.fromRGB(200,80,80),"✗"); return end
                end
                local p=getCurPrice()
                table.insert(Cart,{
                    display=data.Display.." (×"..(v.Qty or 1)..")",
                    productId=v.NormalId; price=p or 0; isGift=isGift;
                    targetName=isGift and SelectedPlayer.Name or "";
                    targetUserId=isGift and SelectedPlayer.UserId or 0;
                })
                notifyCart()
                tw(addQBtn,FAST,{BackgroundColor3=Color3.fromRGB(20,80,20)}); task.delay(.4,function() tw(addQBtn,FAST,{BackgroundColor3=Color3.fromRGB(25,48,25)}) end)
                showToast("Added to queue: "..data.Display,Color3.fromRGB(50,170,80),"✓")
                -- Auto-open queue panel
                if not QueueOpen then setQueueOpen(true) end
            end)
        else
            local passL=Instance.new("TextLabel",card); passL.Size=UDim2.new(1,-16,0,28); passL.Position=UDim2.new(0,8,1,-36)
            passL.BackgroundTransparency=1; passL.Text="Available in Game Pass Store"
            passL.TextColor3=Color3.fromRGB(80,80,80); passL.Font=Enum.Font.Gotham; passL.TextSize=10; passL.TextXAlignment=Enum.TextXAlignment.Center
        end

        table.insert(ProductCards,{Card=card,Category=data.Category,isGiftable=giftable})
    end

    for _,d in ipairs(Products) do createCard(d) end
    applyFilter("All")

    -- Entry animation
    Main.Position=UDim2.new(.5,0,.56,0); Main.BackgroundTransparency=1
    tw(Main,MED,{Position=UDim2.new(.5,0,.5,0),BackgroundTransparency=0})
end -- bootShop

-- ┌─────────────────────────────────────────────────────┐
-- │            KEY VALIDATION HANDLER                   │
-- └─────────────────────────────────────────────────────┘

local validating=false
local function runValidation(rawKey)
    if validating then return end
    if rawKey=="" then keyStatus.Text="Please enter a key."; keyStatus.TextColor3=Color3.fromRGB(180,80,80); return end
    validating=true; keyValidateBtn.Text="Checking…"; keyValidateBtn.Active=false
    keyStatus.Text="Contacting key server…"; keyStatus.TextColor3=Color3.fromRGB(80,80,120)
    task.spawn(function()
        local ok,result=validateKeyFull(rawKey)
        validating=false; keyValidateBtn.Text="Validate Key"; keyValidateBtn.Active=true
        if ok and type(result)=="table" then
            tw(keyCardStroke,MED,{Color=Color3.fromRGB(60,200,100)}); tw(keyGlow,MED,{BackgroundColor3=Color3.fromRGB(60,200,100)}); tw(glowCover,MED,{BackgroundColor3=Color3.fromRGB(60,200,100)})
            local tc2=TIER_DISPLAY[result.Tier] or DEFAULT_TIER
            keyStatus.Text="✓  "..tc2.Label.."  ·  "..result.ExpiryLabel; keyStatus.TextColor3=tc2.Color
            result.SavedAt=unixNow(); saveConfig(result); ActiveKeyData=result; task.wait(.8); bootShop()
        else
            tw(keyCardStroke,MED,{Color=Color3.fromRGB(200,60,60)}); tw(keyGlow,MED,{BackgroundColor3=Color3.fromRGB(200,60,60)}); tw(glowCover,MED,{BackgroundColor3=Color3.fromRGB(200,60,60)})
            local msg=type(result)=="string" and result or "Invalid key."; keyStatus.Text="✗  "..msg; keyStatus.TextColor3=Color3.fromRGB(220,70,70)
            local op=KeyCard.Position
            for _=1,3 do tw(KeyCard,TweenInfo.new(.06),{Position=UDim2.new(.5,-8,.5,0)}); task.wait(.07); tw(KeyCard,TweenInfo.new(.06),{Position=UDim2.new(.5,8,.5,0)}); task.wait(.07) end
            tw(KeyCard,TweenInfo.new(.1),{Position=op})
            task.delay(1.5,function() tw(keyCardStroke,MED,{Color=Color3.fromRGB(80,100,220)}); tw(keyGlow,MED,{BackgroundColor3=Color3.fromRGB(80,120,255)}); tw(glowCover,MED,{BackgroundColor3=Color3.fromRGB(80,120,255)}) end)
        end
    end)
end

keyValidateBtn.MouseButton1Click:Connect(function() runValidation(keyInput.Text) end)
keyInput.FocusLost:Connect(function(ep) if ep then runValidation(keyInput.Text) end end)

if keyAlreadyValid then
    keyStatus.Text="✓ Saved key loaded · "..(ActiveKeyData.ExpiryLabel or "")
    keyStatus.TextColor3=Color3.fromRGB(60,200,100); tw(keyCardStroke,MED,{Color=Color3.fromRGB(60,200,100)})
    task.delay(.6,bootShop)
end
