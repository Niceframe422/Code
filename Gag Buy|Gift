    local ActiveFilter  = "All"
    local FilterButtons = {}
    -- ProductCards: { Card, Category, isGiftable, ref }
    local ProductCards  = {}

    local function applyFilter(cat)
        ActiveFilter = cat
        local isSelf = (SelectedPlayer == LocalPlayer)
        for _, fb in pairs(FilterButtons) do
            local active = (fb.Category == cat)
            local col = active and (cat~="All" and categoryColor(cat) or Color3.fromRGB(90,90,105)) or Color3.fromRGB(36,36,36)
            tw(fb.Button, FAST, { BackgroundColor3=col })
            fb.Button.TextColor3 = active and Color3.fromRGB(240,240,240) or Color3.fromRGB(120,120,120)
        end
        for _, e in pairs(ProductCards) do
            local catMatch = (cat=="All") or (e.Category==cat)
            -- NEW: when another player selected, hide non-giftable items
            local giftableOk = isSelf or e.isGiftable
            e.Card.Visible = catMatch and giftableOk
        end
    end

    -- Re-apply filter whenever player changes
    table.insert(onPlayerChangedCallbacks, function(_)
        applyFilter(ActiveFilter)
    end)

    for i, cat in ipairs(Categories) do
        local fb=Instance.new("TextButton",FilterScroll); fb.LayoutOrder=i; fb.AutoButtonColor=false
        fb.BackgroundColor3=cat=="All" and Color3.fromRGB(75,75,90) or Color3.fromRGB(36,36,36)
