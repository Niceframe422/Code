    local cartRunning = false
    CartRunBtn.MouseButton1Click:Connect(function()
        if cartRunning then return end
        if #Cart == 0 then showToast("Queue is empty.", Color3.fromRGB(150,100,50)); return end

        -- Balance check for full cart
        local bal = getTokenBalance()
        local total = cartTotalCost()
        if bal and total > bal then
            showToast(string.format("⚠ Not enough tokens! Need %d, have %d.", math.ceil(total), math.floor(bal)), Color3.fromRGB(200,100,50))
            return
        end

        cartRunning = true
        CartRunBtn.Text = "Running…"; CartRunBtn.Active=false
        local items = {}; for _,v in ipairs(Cart) do table.insert(items,v) end
        clearCart()

        task.spawn(function()
            local succeeded, failed = 0, 0
            for idx, item in ipairs(items) do
                CartStatusLabel.Text = string.format("[%d/%d] %s…", idx, #items, item.display)
                local ok, err
                if item.isGift then
                    local target = Players:GetPlayerByUserId(item.targetUserId)
                    if not target then
                        failed = failed + 1
                        CartStatusLabel.Text = "⚠ Player left: "..item.targetName
                        task.wait(0.5)
                    else
                        ok, err = pcall(function()
                            GiftRemote:FireServer({ productId=item.productId, targetUserId=item.targetUserId })
                        end)
                        if ok then succeeded=succeeded+1 else failed=failed+1 end
                        task.wait(0.6)
                    end
                else
                    ok, err = pcall(function() PurchaseRemote:InvokeServer(item.productId) end)
                    if ok then succeeded=succeeded+1 else failed=failed+1 end
                    task.wait(0.6)
                end
            end

            cartRunning = false
            CartRunBtn.Text = "▶ Run Queue"; CartRunBtn.Active = true
            CartStatusLabel.Text = string.format("Done: %d ok, %d failed", succeeded, failed)
            showToast(string.format("Queue done: %d purchased, %d failed.", succeeded, failed),
                failed>0 and Color3.fromRGB(200,130,50) or Color3.fromRGB(50,180,90))
            task.delay(4, function() CartStatusLabel.Text="" end)
        end)
    end)

