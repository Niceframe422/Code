-- Global Controller Logic
local function IndependentSystemController()
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	
	local lp = Players.LocalPlayer
	local currentTool = nil
	local isFlinging = false
	local flingConnection = nil
	local punchTrack = nil

	-- PHASE CONTROL SYSTEM
	local FLING_POWER = 100000 -- Drastically raised for rotational velocity flinging stability
	local FLING_DURATION = 0.35 

	local PunchAnim = Instance.new("Animation")
	PunchAnim.AnimationId = "rbxassetid://50777045" 

	local function stopFling()
		isFlinging = false
		StatusLabel.Text = "Ready"
		StatusLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
		if flingConnection then
			flingConnection:Disconnect()
			flingConnection = nil
		end
		
		-- Safely revert velocities to zero to prevent self-tripping
		local character = lp.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end
	end

	local function startFling()
		local startTime = os.clock()
		StatusLabel.Text = "⚡ EXECUTING HIGH VELOCITY FLING ⚡"
		StatusLabel.TextColor3 = Color3.fromRGB(255, 150, 0)
		
		flingConnection = RunService.PreSimulation:Connect(function()
			if not isFlinging then return end
			
			local character = lp.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			
			if hrp then
				local elapsed = os.clock() - startTime
				if elapsed <= FLING_DURATION then
					-- Apply high-speed angular rotation to destabilize targets on contact
					hrp.AssemblyAngularVelocity = Vector3.new(0, FLING_POWER, 0)
				else
					stopFling()
				end
			else
				stopFling()
			end
		end)
	end

	-- Function to safely inject a brand new tool object into inventory
	local function supplyFlingTool()
		if currentTool and currentTool.Parent then currentTool:Destroy() end
		
		local backpack = lp:WaitForChild("Backpack", 5)
		if not backpack then return end
		
		local Tool = Instance.new("Tool")
		Tool.Name = "Punch Fling"
		Tool.RequiresHandle = false
		Tool.CanBeDropped = false
		
		Tool.Activated:Connect(function()
			if isFlinging then return end
			
			local character = lp.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			
			if humanoid and humanoid.Health > 0 then
				local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
				
				if punchTrack then punchTrack:Stop() punchTrack:Destroy() end
				
				punchTrack = animator:LoadAnimation(PunchAnim)
				-- Set priority to upper-body action so walking remains uninterrupted
				punchTrack.Priority = Enum.AnimationPriority.Action
				punchTrack.Looped = false
				punchTrack:Play(0.01)
				
				isFlinging = true
				startFling()
			end
		end)
		
		Tool.Unequipped:Connect(function()
			if punchTrack then punchTrack:Stop() end
			stopFling()
		end)
		
		currentTool = Tool
		Tool.Parent = backpack
	end

	-- Re-supply tool inventory loop
	lp.CharacterAdded:Connect(function(char)
		stopFling()
		task.wait(0.3)
		supplyFlingTool()
		
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then
			hum.Died:Connect(function()
				stopFling()
				if punchTrack then punchTrack:Stop() end
			end)
		end
	end)

	if lp.Character then
		supplyFlingTool()
		local hum = lp.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Died:Connect(function() stopFling() if punchTrack then punchTrack:Stop() end end)
		end
	end

	-- POWER MANAGEMENT CONTROLLER
	local MAX_POWER_LIMIT = 500
	
	local function updatePowerValue(newValue)
		local num = tonumber(newValue)
		if num then
			num = math.clamp(num, 0, MAX_POWER_LIMIT)
			FLING_POWER = num * 1000 -- Scaling multiplier for physics engine efficiency
			PowerInput.Text = tostring(num)
			
			local percentage = num / MAX_POWER_LIMIT
			SliderPin.Position = UDim2.new(percentage, -5, -0.75, 0)
		end
	end

	PowerInput.FocusLost:Connect(function(enterPressed)
		updatePowerValue(PowerInput.Text)
	end)

	-- Basic slider functional framework
	local dragging = false
	SliderPin.MouseButton1Down:Connect(function()
		dragging = true
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	RunService.RenderStepped:Connect(function()
		if dragging then
			local mousePos = UserInputService:GetMouseLocation().X
			local trackLeft = SliderTrack.AbsolutePosition.X
			local trackWidth = SliderTrack.AbsoluteSize.X
			local percentage = math.clamp((mousePos - trackLeft) / trackWidth, 0, 1)
			
			local calculatedValue = math.round(percentage * MAX_POWER_LIMIT)
			updatePowerValue(calculatedValue)
		end
	end)
end

IndependentSystemController()
