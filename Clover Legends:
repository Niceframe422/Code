    if not (IS_DUNGEON or IS_DEVIL) then return end
    task.spawn(function()
        while true do
            if not (IS_DUNGEON or IS_DEVIL) then break end
            local hum = humRef
            if not hum or not hum.Parent then refreshChar() hum = humRef end
            if hum and (hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead) then
                pcall(function()
                    local folder = ReplicatedStorage:FindFirstChild("WK_Remotes") or remoteFolder()
                    local rev = folder and folder:FindFirstChild("DungeonRevive")
                    if rev then rev:FireServer("Revive") end
                end)
                task.wait(0.15)
            else
                task.wait(0.05)
            end
        end
    end)
end
