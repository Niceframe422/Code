end

local function getChestPrompt(objectText)
    local folder = Workspace:FindFirstChild("WK_DungeonChests")
    if not folder then return nil, nil end
    for _, inst in ipairs(folder:GetDescendants()) do
        if inst:IsA("ProximityPrompt") and tostring(inst.ObjectText) == objectText then
            return inst, inst.Parent
        end
    end
    return nil, nil
end
local function getVaultPrompt()
    local vault = Workspace:FindFirstChild("DungeonArea") and Workspace.DungeonArea:FindFirstChild("ElementalVault")
    if not vault then return nil, nil end
    return vault:FindFirstChild("WK_VaultPrompt", true), vault
end
local function triggerPromptFew(prompt, part, times)
    times = times or 3
    for _ = 1, times do
        if shouldAbortDungeon() then return end
        firePrompt(prompt, part)
        task.wait(0.35)
    end
end
local function goVaultAndTrigger(times)
    times = times or 3
    local vaultPrompt, vaultModel = getVaultPrompt()
    if not vaultPrompt then return end
    local part = vaultModel and (vaultModel:FindFirstChild("WK_VaultPrompt") or vaultModel.PrimaryPart)
    local hrp = getHRP()
    if hrp and part and part:IsA("BasePart") then
        hrp.CFrame = cf(part.Position + v3(0, 4, 0))
        task.wait(0.3)
    end
    triggerPromptFew(vaultPrompt, part, times)
end
local function clearAllEnemies(timeout)
    timeout = timeout or 90
    local deadline = tick_() + timeout
    while tick_() < deadline do
        if shouldAbortDungeon() then return end
        local target = nil
        local folder = enemiesFolder()
        if folder then
            for _, prefer in ipairs({"RedWitch", "ZombieBoss", "Zombie"}) do
                for _, e in ipairs(folder:GetChildren()) do
                    if e:IsA("Model") and isLive(e) and (e.Name == prefer or getEnemyIdentity(e) == prefer) then
                        target = e
                        break
                    end
                end
                if target then break end
            end
            if not target then
                for _, e in ipairs(folder:GetChildren()) do
                    if e:IsA("Model") and isLive(e) then target = e break end
                end
            end
        end
        if not target then break end
        combatOrbit(target, true)
        task.wait(0.05)
    end
end

-- CORRECT Spirit Dungeon sequence
local function runSpiritDungeonSequence()
    if dungeonBusy then return end
    dungeonBusy = true
    clearDungeonCancel()
    setStatus("Dungeon start")

    -- 1) Wind Chest
    local windPrompt, windBody = getChestPrompt("Wind Chest")
    if windPrompt then
        setStatus("1. Wind Chest")
        local hrp = getHRP()
        if hrp and windBody and windBody:IsA("BasePart") then
            hrp.CFrame = cf(windBody.Position + v3(0, 3, 0))
            task.wait(0.3)
        end
        triggerPromptFew(windPrompt, windBody, 3)
    end
    if shouldAbortDungeon() then dungeonBusy = false return end

    -- 2) Wait for Zombies and clear them
    setStatus("2. Waiting for Zombies...")
    task.wait(1.2)
    local waited = 0
    while waited < 8 do
        if shouldAbortDungeon() then dungeonBusy = false return end
        if countByName("Zombie") > 0 or countByName("ZombieBoss") > 0 then break end
        task.wait(0.5)
        waited = waited + 0.5
    end
    if countByName("Zombie") > 0 or countByName("ZombieBoss") > 0 then
        setStatus("2. Clearing Zombies")
        clearAllEnemies(70)
    end
    if shouldAbortDungeon() then dungeonBusy = false return end

    -- 3) Retrigger Wind Chest
    windPrompt, windBody = getChestPrompt("Wind Chest")
    if windPrompt then
        setStatus("3. Retrigger Wind Chest")
        local hrp = getHRP()
        if hrp and windBody and windBody:IsA("BasePart") then
            hrp.CFrame = cf(windBody.Position + v3(0, 3, 0))
            task.wait(0.25)
        end
        triggerPromptFew(windPrompt, windBody, 2)
    end
    if shouldAbortDungeon() then dungeonBusy = false return end

    -- 4) Vault
    setStatus("4. Vault")
    goVaultAndTrigger(3)
    if shouldAbortDungeon() then dungeonBusy = false return end

    -- 5) Fire Chest
    local firePrompt, fireBody = getChestPrompt("Fire Chest")
    if firePrompt then
        setStatus("5. Fire Chest")
        local hrp = getHRP()
        if hrp and fireBody and fireBody:IsA("BasePart") then
            hrp.CFrame = cf(fireBody.Position + v3(0, 3, 0))
            task.wait(0.3)
        end
        triggerPromptFew(firePrompt, fireBody, 2)
    end
    if shouldAbortDungeon() then dungeonBusy = false return end

    -- 6) Vault
    setStatus("6. Vault")
    goVaultAndTrigger(3)
    if shouldAbortDungeon() then dungeonBusy = false return end

    -- 7) Water boss area → RedWitch spawns when you arrive
    setStatus("7. Water boss area (spawn RedWitch)")
    local bossesFolder = Workspace:FindFirstChild("DungeonArea") and Workspace.DungeonArea:FindFirstChild("Bosses")
    if bossesFolder then
        local waterPad = bossesFolder:FindFirstChild("WaterBoss")
        if waterPad then
            local part = waterPad:IsA("BasePart") and waterPad or waterPad:FindFirstChildWhichIsA("BasePart")
            if part then
                local hrp = getHRP()
                if hrp then hrp.CFrame = cf(part.Position + v3(0, 5, 0)) end
                task.wait(1.0) -- give time for RedWitch to spawn
            end
        end
    end

    -- 8) Defeat RedWitch
    setStatus("8. Defeat RedWitch")
    local deadline = tick_() + 100
    while tick_() < deadline do
        if shouldAbortDungeon() then break end
        local witch = findEnemy("RedWitch")
        if witch and isLive(witch) then
            combatOrbit(witch, true)
        else
            -- if no witch and no other enemies, done with this phase
            local any = false
            local folder = enemiesFolder()
            if folder then
                for _, e in ipairs(folder:GetChildren()) do
                    if e:IsA("Model") and isLive(e) then any = true break end
                end
            end
            if not any then break end
            clearAllEnemies(15)
        end
        task.wait(0.05)
    end
    if shouldAbortDungeon() then dungeonBusy = false return end

    -- 9) Vault after RedWitch key drop
    setStatus("9. Vault (RedWitch key)")
    goVaultAndTrigger(4)
    if shouldAbortDungeon() then dungeonBusy = false return end

    -- 10) Final boss ONLY after vault
    setStatus("10. Final boss")
    if bossesFolder then
        local finalPad = bossesFolder:FindFirstChild("FinalBoss")
        if finalPad then
            local part = finalPad:IsA("BasePart") and finalPad or finalPad:FindFirstChildWhichIsA("BasePart")
            if part then
                local hrp = getHRP()
                if hrp then hrp.CFrame = cf(part.Position + v3(0, 5, 0)) end
            end
        end
    end
    task.wait(0.5)
    local hrp = getHRP()
    if hrp then hrp.CFrame = hrp.CFrame + v3(0, 50, 0) end
    clearAllEnemies(120)

