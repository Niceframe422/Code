local function isLive(enemy)
    if not enemy or not enemy.Parent then return false end
    local root = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
    if not root then return false end
    local hum = enemy:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health > 0 end
    local h = enemy:GetAttribute("Health")
    return typeof(h) == "number" and h > 0
end
local function enemyRoot(enemy)
    return enemy and (enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart) or nil
end
local function getEnemyIdentity(enemy)
    if not enemy then return nil end
    local attr = enemy:GetAttribute("EnemyId")
    if typeof(attr) == "string" and attr ~= "" then return attr end
    return enemy.Name
end
