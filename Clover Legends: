local function findRadarPoiFolder()
    local folder = ReplicatedStorage:FindFirstChild("WK_RadarPoi")
    if folder then return folder end
    for _, inst in ipairs(ReplicatedStorage:GetChildren()) do
        if inst.Name:find("RadarPoi") then return inst end
    end
    return nil
end
local function getConfigPosition(config)
    if not config then return nil end
    local pos = config:GetAttribute("Position")
    if typeof(pos) == "Vector3" then return pos end
    local anchor = config:GetAttribute("Anchor")
    if typeof(anchor) == "Vector3" then return anchor end
    return nil
end
local function getAllBossConfigs()
    local folder = findRadarPoiFolder()
    local list = {}
    if not folder then return list end
    for _, child in ipairs(folder:GetChildren()) do
        local name = child.Name
        if string.find(name, "Boss_", 1, true) or child:GetAttribute("Kind") == "Boss" then
            local alive  = child:GetAttribute("Alive")
            local spawns = child:GetAttribute("Spawns") or child:GetAttribute("Respawn")
            local isPresent = (typeof(alive) == "number" and alive >= 1) or (typeof(spawns) == "number" and spawns >= 1)
            local enemyId   = child:GetAttribute("EnemyId")
            local enemyName = child:GetAttribute("EnemyName")
            local displayName = (typeof(enemyId) == "string" and enemyId ~= "" and enemyId)
                             or (typeof(enemyName) == "string" and enemyName ~= "" and enemyName) or name
            list[#list + 1] = {
                Config = child, Name = name, Position = getConfigPosition(child),
                EnemyName = displayName, EnemyId = enemyId, Island = child:GetAttribute("Island"),
                Alive = alive, Spawns = spawns, IsPresent = isPresent,
            }
        end
    end
    table.sort(list, function(a, b) return a.Name < b.Name end)
    return list
end
local function getTeleportConfigs()
    local folder = findRadarPoiFolder()
    local list = {}
    if not folder then return list end
    for _, child in ipairs(folder:GetChildren()) do
        if string.find(child.Name, "Teleport", 1, true) or child:GetAttribute("Kind") == "Teleport" then
            local pos = getConfigPosition(child)
            if pos then
                list[#list + 1] = { Name = child.Name, Position = pos, Island = child:GetAttribute("Island") }
            end
        end
    end
    table.sort(list, function(a, b) return a.Name < b.Name end)
    return list
end
