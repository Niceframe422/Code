local function stepOverworld()
    local now = tick_()
    if now - lastEnemyRef >= 2.5 then lastEnemyRef = now pcall(refreshEnemies, false) end
    if now - lastSkillRef >= 2.5 then lastSkillRef = now pcall(refreshSkills, false) end
    if now - lastBossRef  >= 4.5 then lastBossRef  = now pcall(refreshBossConfigs) end

    handlePotions()
    handleAutoShopBuy()

    if Toggles.AutoOpenChests and Toggles.AutoOpenChests.Value and (now - lastChestOpen) >= 30 then
        lastChestOpen = now
        autoOpenInventoryChests()
    end

    if chestBusy then return end

    if not fightingBoss and Toggles.AutoChest and Toggles.AutoChest.Value then
        local chestCD = (Options.ChestCooldown and Options.ChestCooldown.Value) or 70
        local islandCD = (Options.IslandInterval and Options.IslandInterval.Value) or 120
        local islandDue = Toggles.LoadIslands and Toggles.LoadIslands.Value and (now - lastIsland) >= islandCD
        local chestDue = (now - lastChest) >= chestCD
        if chestDue or islandDue then
            lastChest = now
            if islandDue then lastIsland = now end
            task.spawn(function()
                pcall(runChestTrip, Toggles.LoadIslands and Toggles.LoadIslands.Value)
            end)
            return
        end
    end

    if Toggles.AutoStat and Toggles.AutoStat.Value and now - lastStat >= ((Options.StatInterval and Options.StatInterval.Value) or 1.5) then
        lastStat = now
        local picked = Options.SelectedStats and Options.SelectedStats.Value
        local amount = (Options.AutoStatAmount and Options.AutoStatAmount.Value) or 8
        if type(picked) == "table" then
            for stat, on in pairs(picked) do
                if on == true then fireRemote("AssignStatPoint", stat, amount) end
            end
        end
    end

    if SpinLoopsEnabled and Toggles.SpinUntilTarget and Toggles.SpinUntilTarget.Value then
        local id = readGrimoireId()
        if id and mapHas(Options.TargetGrimoire and Options.TargetGrimoire.Value, id) then
            SpinLoopsEnabled = false
            if Toggles.AutoSpin then pcall(function() Toggles.AutoSpin:SetValue(false) end) end
        end
    end

    if not farmOn() and not bossFarmOn() then
        if combatActive then releaseLock() end
        setStatus("Status: Idle")
        return
    end

    if not bookOpen() then
        if now - lastEquip > 0.9 then
            pressKey(Enum.KeyCode.Three)
            lastEquip = now
        end
        setStatus("Status: equip book")
        return
    end

    local target = acquireTargetOverworld()
    if not target then
        setStatus("Status: waiting / no target")
        return
    end
    if not enemyRoot(target) then
        releaseLock()
        return
    end

    combatOrbit(target, true)

    if InfoLabel and InfoLabel.SetText then
        pcall(function()
            local extra = currentBossConfig and (" | " .. currentBossConfig.Name) or ""
            InfoLabel:SetText(string.format("Lock: %s%s", getEnemyIdentity(target) or target.Name, extra))
        end)
    end
end

local function stepDungeon()
    if not dungeonMasterOn() then
        if dungeonBusy then requestDungeonCancel() end
        if not dungeonBusy then setStatus("Status: Dungeon idle") end
        combatActive = false
        return
    end
    if not dungeonBusy then
        clearDungeonCancel()
        task.spawn(runSpiritDungeonSequence)
    end
end

local function stepDevil()
    if not devilFarmOn() then
        setStatus("Status: Devil idle")
        combatActive = false
        return
    end
    runDevilDungeon()
end

heartbeatConn = RunService.Heartbeat:Connect(function(dt)
    if Library.Unloaded then return end
    stepAccum = stepAccum + dt
    if stepAccum < 0.05 then return end
    stepAccum = 0
    if not uiReady then return end
    if IS_DUNGEON then
        pcall(stepDungeon)
    elseif IS_DEVIL then
        pcall(stepDevil)
    elseif IS_OVERWORLD then
        pcall(stepOverworld)
    else
        setStatus("Unknown PlaceId " .. tostring(CURRENT_PLACE))
    end
end)

