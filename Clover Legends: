end
local function bookOpen()
    local c = LocalPlayer.Character
    return c ~= nil and c:GetAttribute("WK_BookOpen") == true
end
local function readGrimoireId()
    local c = LocalPlayer.Character
    if not c then return nil end
    local attr = c:GetAttribute("WK_GrimoireId")
    if typeof(attr) ~= "string" or attr == "" then return nil end
    if GrimoireMatrix[attr] then return attr end
    local compact = string.lower(attr:gsub("%s+", ""))
    for k in pairs(GrimoireMatrix) do
        if string.lower(k:gsub("%s+", "")) == compact then return k end
    end
    return attr
end
local function playerHpRatio()
    local hum = humRef
    if not hum or not hum.Parent then refreshChar() hum = humRef end
    if not hum or hum.MaxHealth <= 0 then return 1 end
    return hum.Health / hum.MaxHealth
end
local function healthDropped()
    local hum = humRef
    if not hum or not hum.Parent then return false end
    if lastHpWatch == nil then lastHpWatch = hum.Health return false end
    if hum.Health < lastHpWatch - 0.05 then lastHpWatch = hum.Health return true end
    lastHpWatch = hum.Health
    return false
end
local function checkDashState()
    local now = tick_()
    if now - lastDashCheck < 0.1 then return isDashing end
    lastDashCheck = now
    local hrp = getHRP()
    if not hrp then isDashing = false return false end
    local vel = hrp.AssemblyLinearVelocity
    isDashing = Vector3.new(vel.X, 0, vel.Z).Magnitude > 60
    return isDashing
end
local function orbitCFrame(root, radius, height, angle)
    local pos = root.Position + v3(cos(angle) * radius, height, sin(angle) * radius)
    return cf(pos, root.Position)
end
local function isBossTarget(enemy)
    if not enemy then return false end
    if currentBossConfig then return true end
    local ident = getEnemyIdentity(enemy)
    if DODGE_BOSSES[ident] or DODGE_BOSSES[enemy.Name] then return true end
    if Options.DodgeBossList and (mapHas(Options.DodgeBossList.Value, ident) or mapHas(Options.DodgeBossList.Value, enemy.Name)) then
        return true
    end
    return false
end

local function handlePotions()
    local now = tick_()
    local hpRatio = playerHpRatio()
    if Toggles.AutoHealPotion and Toggles.AutoHealPotion.Value then
        if hpRatio <= cfgLowHp() and (now - lastHealEquip) > 3.0 then
            lastHealEquip = now
            firePotionEquip("HealPotion")
            task.wait(0.08)
            fireUsePotion("Heal")
            task.wait(0.08)
            firePotionEquip("ManaPotion")
            task.wait(0.08)
            fireUsePotion("Mana")
            lastManaPotion = now
        end
    end
    if Toggles.AutoManaPotion and Toggles.AutoManaPotion.Value then
        if (now - lastManaPotion) >= 300 then
            lastManaPotion = now
            firePotionEquip("ManaPotion")
            task.wait(0.08)
            fireUsePotion("Mana")
        end
    end
end

local function combatOrbit(enemy, allowAttack)
    if not isLive(enemy) then return false end
    local root = enemyRoot(enemy)
    if not root then return false end
    local hrp = getHRP()
    if not hrp then return false end
    if checkDashState() then return true end

    local now = tick_()
    local radius = cfgOrbitRadius()
    local height = cfgOrbitHeight()
    local speed = cfgOrbitSpeed()

    if isBossTarget(enemy) then
        radius = math.max(radius * 2.0, 28)
        height = height + 12
    end
    if (healthDropped() or playerHpRatio() <= cfgLowHp()) and (now - lastEvasion > 1.1) then
        lastEvasion = now
        radius = radius + 10
        height = height + 8
        safetyUntil = now + 0.9
        pressKey(Enum.KeyCode.Five)
        handlePotions()
    end
    if now < safetyUntil or now < fleeUntil then
        radius = radius + 12
        height = height + 10
    end

    orbitAngle = orbitAngle + speed
    if orbitAngle > pi2 then orbitAngle = orbitAngle - pi2 end

    if now - lastBlink >= cfgBlinkInterval() then
        orbitAngle = rng:NextNumber(0, pi2)
        lastBlink = now
        if Toggles.UnpredictableBlink and Toggles.UnpredictableBlink.Value then
            local blinkR = radius * rng:NextNumber(0.7, 1.3)
            local blinkH = height + rng:NextNumber(-3, 6)
            local blinkPos = root.Position + v3(cos(orbitAngle) * blinkR, blinkH, sin(orbitAngle) * blinkR)
            pcall(function() hrp.CFrame = cf(blinkPos, root.Position) end)
        end
    end

    local dest = orbitCFrame(root, radius, height, orbitAngle)
    pcall(function()
        hrp.CFrame = dest
        softHoldHeight(hrp, dest.Position.Y)
    end)

    if allowAttack then
        pcall(function()
            if useRemotes() then
                local targetPos = root.Position
                local myCF = lookAt(hrp.Position, targetPos)
                comboIndex = (comboIndex % 2) + 1
                fireRemote("BasicAttack", myCF, comboIndex, targetPos, 0)
                local selected = Options.AutoSkills and Options.AutoSkills.Value
                if type(selected) == "table" then
                    for skill, on in pairs(selected) do
                        if on == true and skill ~= "None" then
                            fireRemote("CastSkill", skill, myCF, targetPos)
                        end
                    end
                end
                local grim = readGrimoireId()
                local skills = grim and GrimoireMatrix[grim]
                if skills and #skills > 0 then
                    lastSkillIndex = (lastSkillIndex % #skills) + 1
                    fireRemote("CastSkill", skills[lastSkillIndex], myCF, targetPos)
                end
            end
        end)
        spamKeysFull()
    end
    setStatus("ATK → " .. (getEnemyIdentity(enemy) or enemy.Name))
    return true
end

local function firePrompt(prompt, part)
    if not prompt then return false end
    return pcall(function()
        if part and part:IsA("BasePart") then
            local hrp = getHRP()
            if hrp then hrp.CFrame = cf(part.Position + v3(0, 3, 0)) end
            task.wait(0.08)
        end
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 150
        prompt.RequiresLineOfSight = false
        for _ = 1, 2 do
            if fireproximityprompt then fireproximityprompt(prompt) end
            prompt:InputHoldBegin()
            task.wait(0.05)
            prompt:InputHoldEnd()
            if fireproximityprompt then fireproximityprompt(prompt) end
            task.wait(0.04)
        end
    end)
end

local function mergeSavedIntoNames(names, saved)
    local have = {}
    for i = 1, #names do have[names[i]] = true end
    if type(saved) == "table" then
        for name, on in pairs(saved) do
            if on == true and typeof(name) == "string" and name ~= "" and not have[name] then
                names[#names + 1] = name
                have[name] = true
            end
        end
    end
end
local function buildEnemyNames()
    table.clear(nameBuf)
    table.clear(seenBuf)
    local function add(n)
        if typeof(n) == "string" and n ~= "" and not seenBuf[n] then
            seenBuf[n] = true
            nameBuf[#nameBuf + 1] = n
        end
    end
    local folder = enemiesFolder()
    if folder then
        for _, e in ipairs(folder:GetChildren()) do
            if e:IsA("Model") then add(getEnemyIdentity(e)) add(e.Name) end
        end
    end
    for _, entry in ipairs(getAllBossConfigs()) do
        if entry.EnemyId and entry.EnemyId ~= "" then add(entry.EnemyId) end
        if entry.EnemyName and entry.EnemyName ~= "" then add(entry.EnemyName) end
    end
    mergeSavedIntoNames(nameBuf, savedTargetSel)
    mergeSavedIntoNames(nameBuf, savedTopSel)
    mergeSavedIntoNames(nameBuf, savedBossSel)
    if Options.TargetEnemies then mergeSavedIntoNames(nameBuf, Options.TargetEnemies.Value) end
    if Options.TopPriorityEnemies then mergeSavedIntoNames(nameBuf, Options.TopPriorityEnemies.Value) end
    if Options.BossList then mergeSavedIntoNames(nameBuf, Options.BossList.Value) end
    table.sort(nameBuf)
    return nameBuf
end
local function refreshEnemies(force)
    if not Options.TargetEnemies then return end
    local names = buildEnemyNames()
    if #names == 0 then names = {"(none yet)"} end
    local sig = table.concat(names, "\0")
    if not force and sig == lastNameSig then return end
    lastNameSig = sig
    if Options.TargetEnemies and mapAny(Options.TargetEnemies.Value) then savedTargetSel = copyTrue(Options.TargetEnemies.Value) end
    if Options.TopPriorityEnemies and mapAny(Options.TopPriorityEnemies.Value) then savedTopSel = copyTrue(Options.TopPriorityEnemies.Value) end
    if Options.BossList and mapAny(Options.BossList.Value) then savedBossSel = copyTrue(Options.BossList.Value) end
    pcall(function()
        Options.TargetEnemies:SetValues(names)
        Options.TopPriorityEnemies:SetValues(names)
        if Options.BossList then Options.BossList:SetValues(names) end
        Options.TargetEnemies:SetValue(savedTargetSel)
        Options.TopPriorityEnemies:SetValue(savedTopSel)
        if Options.BossList then Options.BossList:SetValue(savedBossSel) end
    end)
end

-- Boss selection persistence
local function refreshBossConfigs()
    if not Options.BossConfigList then return end
    if type(Options.BossConfigList.Value) == "table" then
        for k, v in pairs(Options.BossConfigList.Value) do
            if v == true then
                local clean = tostring(k):gsub(" %[ALIVE%]", ""):gsub(" %[dead%]", "")
                savedBossConfigSel[clean] = true
            end
        end
    end
    local configs = getAllBossConfigs()
    local names = {}
    for i, entry in ipairs(configs) do
        local label = entry.EnemyName or entry.EnemyId or entry.Name
        names[i] = label .. (entry.IsPresent and " [ALIVE]" or " [dead]")
    end
    if #names == 0 then names[1] = "None" end
    pcall(function()
        Options.BossConfigList:SetValues(names)
        local restore = {}
        for _, fullName in ipairs(names) do
            local clean = tostring(fullName):gsub(" %[ALIVE%]", ""):gsub(" %[dead%]", "")
            if savedBossConfigSel[clean] then restore[fullName] = true end
        end
        if mapAny(restore) then Options.BossConfigList:SetValue(restore) end
    end)
end

local function refreshSkills(force)
    if not Options.AutoSkills then return end
    local key = readGrimoireId()
    if key and not GrimoireMatrix[key] then key = nil end
    if not force and skillsReady and key == lastGrimKey then return end
    local prev = copyTrue(Options.AutoSkills.Value)
    local skills = (key and GrimoireMatrix[key]) or {"None"}
    pcall(function()
        Options.AutoSkills:SetValues(skills)
        Options.AutoSkills:SetText("Skills (" .. (key or "?") .. ")")
        if mapAny(prev) then
            Options.AutoSkills:SetValue(prev)
        else
            local all = {}
            for i = 1, #skills do if skills[i] ~= "None" then all[skills[i]] = true end end
            Options.AutoSkills:SetValue(all)
        end
    end)
    lastGrimKey = key
    skillsReady = true
end

local function acquireTargetOverworld()
    fightingBoss = false
    if lockedTarget and isLive(lockedTarget) then return lockedTarget end
    if lockedTarget and not isLive(lockedTarget) then releaseLock() end
    local folder = enemiesFolder()
    local hrp = getHRP()
    if not folder or not hrp then return nil end

    if bossFarmOn() and Options.BossConfigList and mapAny(Options.BossConfigList.Value) then
        local selected = Options.BossConfigList.Value
        for k, v in pairs(selected) do
            if v == true then
                local clean = tostring(k):gsub(" %[ALIVE%]", ""):gsub(" %[dead%]", "")
                savedBossConfigSel[clean] = true
            end
        end
        local allConfigs = getAllBossConfigs()
        for _, entry in ipairs(allConfigs) do
            local label = entry.EnemyName or entry.EnemyId or entry.Name
            local matched = mapHas(selected, label) or mapHas(selected, label .. " [ALIVE]")
                         or mapHas(selected, label .. " [dead]") or mapHas(selected, entry.Name)
                         or mapHas(selected, entry.Name .. " [ALIVE]")
                         or mapHas(savedBossConfigSel, label)
                         or mapHas(savedBossConfigSel, entry.EnemyId)
                         or mapHas(savedBossConfigSel, entry.Name)
            if matched and entry.IsPresent and entry.Position then
                local dist = (hrp.Position - entry.Position).Magnitude
                if dist > 70 then
                    goToBossConfig(entry)
                    task.wait(0.4)
                end
                local bossModel = entry.EnemyId and findEnemy(entry.EnemyId) or nil
                if not bossModel and entry.EnemyName then bossModel = findEnemy(entry.EnemyName) end
                if bossModel and isLive(bossModel) then
                    lockedTarget = bossModel
                    currentBossConfig = entry
                    fightingBoss = true
                    combatActive = true
                    lastHpWatch = humRef and humRef.Health
                    lastBlink = tick_()
                    return bossModel
                end
            end
        end
    end

    if not farmOn() then return nil end
    local top = Options.TopPriorityEnemies and Options.TopPriorityEnemies.Value or savedTopSel
    local tgt = Options.TargetEnemies and Options.TargetEnemies.Value or savedTargetSel
    local bosses = Options.BossList and Options.BossList.Value or savedBossSel
    local hasFilter = mapAny(top) or mapAny(tgt) or mapAny(bosses)
    local origin = hrp.Position
    local best, bestDist = nil, 1e9
    for _, e in ipairs(folder:GetChildren()) do
        if e:IsA("Model") and isLive(e) then
            local root = enemyRoot(e)
            if root then
                local ident = getEnemyIdentity(e)
                local allowed = true
                if hasFilter then
                    allowed = mapHas(top, ident) or mapHas(tgt, ident) or mapHas(bosses, ident)
                           or mapHas(top, e.Name) or mapHas(tgt, e.Name) or mapHas(bosses, e.Name)
                end
                if allowed then
                    local d = (root.Position - origin).Magnitude
                    local prio = EnemyPriority[ident] or EnemyPriority[e.Name] or 0
                    if mapHas(top, ident) or mapHas(top, e.Name) then d = d * 0.4 end
                    d = d - (prio * 0.5)
                    if d < bestDist then best, bestDist = e, d end
                end
            end
        end
    end
    if best then
        lockedTarget = best
        combatActive = true
        lastHpWatch = humRef and humRef.Health
        lastBlink = tick_()
        return best
    end
    if not hasFilter then
        for _, e in ipairs(folder:GetChildren()) do
            if e:IsA("Model") and isLive(e) and enemyRoot(e) then
                lockedTarget = e
                combatActive = true
                lastHpWatch = humRef and humRef.Health
                lastBlink = tick_()
                return e
            end
        end
    end
    return nil
end

local function collectWorldChests()
    local folder = Workspace:FindFirstChild("WK_Chests")
    if not folder then return end
    for _, chest in ipairs(folder:GetChildren()) do
        if chest:IsA("Model") then
            local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
            local part = chest:FindFirstChild("Body") or chest:FindFirstChildWhichIsA("BasePart", true)
            if prompt then
                pcall(firePrompt, prompt, part)
                task.wait(0.45)
            end
        end
    end
end
local function visitIslandsFromRadar()
    local teleports = getTeleportConfigs()
    for _, entry in ipairs(teleports) do
        if fightingBoss then break end
        if not (Toggles.AutoChest and Toggles.AutoChest.Value) and not (Toggles.LoadIslands and Toggles.LoadIslands.Value) then break end
        setStatus("Island: " .. (entry.Island or entry.Name))
        if entry.Island and Toggles.UseTeleportSelect and Toggles.UseTeleportSelect.Value then
            fireTeleportSelect(entry.Island)
            task.wait(2.2)
        else
            teleportToPosition(entry.Position, 14)
            task.wait(1.8)
        end
        collectWorldChests()
        task.wait(1.2)
    end
end
local function runChestTrip(doIslands)
    if not IS_OVERWORLD then return end
    if chestBusy or fightingBoss then return end
    chestBusy = true
    releaseLock()
    local hrp = getHRP()
    local savedCF = hrp and hrp.CFrame or nil
    setStatus("Chest trip")
    pcall(function()
        if doIslands then visitIslandsFromRadar() else collectWorldChests() end
    end)
    task.wait(0.6)
    local cur = getHRP()
    if cur and savedCF then pcall(function() cur.CFrame = savedCF end) end
    chestBusy = false
    setStatus("Back from chest")
end

-- Multi-rarity inventory chests
local function autoOpenInventoryChests()
    if not (Toggles.AutoOpenChests and Toggles.AutoOpenChests.Value) then return end
    local selected = Options.ChestRaritySelect and Options.ChestRaritySelect.Value
    local count = (Options.ChestAmount and Options.ChestAmount.Value) or 50
    if type(selected) ~= "table" or not mapAny(selected) then
        fireChestOpen(3, count) -- default legendary
        return
    end
    for name, on in pairs(selected) do
        if on == true then
            local rarity = CHEST_RARITY_MAP[name]
            if rarity then
                fireChestOpen(rarity, count)
                task.wait(0.15)
            end
        end
    end
end

local function handleAutoShopBuy()
    if not IS_OVERWORLD then return end
    local now = tick_()
    if now - lastShopBuy < 8 then return end
    lastShopBuy = now
    if Toggles.AutoBuyMaterial and Toggles.AutoBuyMaterial.Value then
        local name = Options.MaterialSelect and Options.MaterialSelect.Value
