local function safeHttpLoad(url)
    local okGet, body = pcall(function() return game:HttpGet(url) end)
    if not okGet or type(body) ~= "string" or body == "" then return nil end
    local okChunk, chunk = pcall(function() return loadstring(body) end)
    if not okChunk or type(chunk) ~= "function" then return nil end
    local okRun, result = pcall(chunk)
    if not okRun then return nil end
    return result
end

