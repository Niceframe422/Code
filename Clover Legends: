local function addGroupbox(tab, side, name)
    side = (side == "Right") and "Right" or "Left"
    if tab.AddGroupbox then
        local ok, box = pcall(function() return tab:AddGroupbox({ Side = side, Name = name }) end)
        if ok and box then return box end
    end
    if side == "Right" and tab.AddRightGroupbox then
        local ok, box = pcall(function() return tab:AddRightGroupbox(name) end)
        if ok and box then return box end
    end
    if tab.AddLeftGroupbox then
        local ok, box = pcall(function() return tab:AddLeftGroupbox(name) end)
        if ok and box then return box end
    end
    return tab:AddLeftGroupbox(name)
end
