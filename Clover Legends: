local function startClaimLoop()
    task.spawn(function()
        local remotes = getRemotes()
        if not remotes then return end
        local daily    = remotes:FindFirstChild("DailyRewardClaim") or remotes:WaitForChild("DailyRewardClaim", 5)
        local discord  = remotes:FindFirstChild("ClaimDiscordReward") or remotes:WaitForChild("ClaimDiscordReward", 5)
        local free     = remotes:FindFirstChild("FreeRewardClaim") or remotes:WaitForChild("FreeRewardClaim", 5)
        local playtime = remotes:FindFirstChild("PlayTimeClaim") or remotes:WaitForChild("PlayTimeClaim", 5)
        while task.wait(5.0) do
            if ClaimLoopsEnabled then
                if discord then pcall(function() discord:InvokeServer(true) end) end
                if free then pcall(function() free:FireServer(true) end) end
                if playtime then
                    for i = 1, 10 do
                        if not ClaimLoopsEnabled then break end
                        pcall(function() playtime:FireServer(i) end)
                        task.wait(0.1)
                    end
                end
                if daily then
                    for i = 1, 10 do
                        if not ClaimLoopsEnabled then break end
                        pcall(function() daily:FireServer(i) end)
                        task.wait(0.1)
                    end
                end
            end
        end
    end)
end

local function startDropLoop()
    task.spawn(function()
        local remotes = getRemotes()
        if not remotes then return end
        local drop = remotes:FindFirstChild("DropGrimoire") or remotes:WaitForChild("DropGrimoire", 5)
        if not drop then return end
        while task.wait(1.5) do
            if DropLoopsEnabled then
                local list = Options.DropGrimoireList and Options.DropGrimoireList.Value
                local wanted = Options.WantedDrops and Options.WantedDrops.Value
                local toDrop = {}
                if type(list) == "table" and mapAny(list) then
                    for name, on in pairs(list) do
                        if on == true and not (type(wanted) == "table" and wanted[name] == true) then
                            toDrop[#toDrop + 1] = name
                        end
                    end
                else
                    for _, name in pairs(DROP_GRIMOIRES) do
                        if not (type(wanted) == "table" and wanted[name] == true) then
                            toDrop[#toDrop + 1] = name
                        end
                    end
                end
                for _, grimoireName in pairs(toDrop) do
                    if not DropLoopsEnabled then break end
                    for _ = 1, 10 do
                        if not DropLoopsEnabled then break end
                        pcall(function() drop:FireServer({Id = grimoireName}) end)
                    end
                    task.wait(0.05)
                end
            end
        end
    end)
end

